<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparse package ("packaging with external location"): gives the unpackaged Atoll.exe a package
  identity so it can read Windows notifications. The package holds only this manifest and logos;
  Atoll.exe stays where it is (the -ExternalLocation folder). Publisher must match the signing
  certificate subject and the <msix> element in src/Atoll.App/app.manifest.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap10 rescap">

  <Identity Name="Atoll" Publisher="CN=Atoll Dev" Version="0.4.0.0" ProcessorArchitecture="neutral" />

  <Properties>
    <DisplayName>Atoll</DisplayName>
    <PublisherDisplayName>Atoll</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>

  <Applications>
    <Application Id="Atoll" Executable="Atoll.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="Atoll"
        Description="Dynamic island for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
    </Application>
  </Applications>
</Package>
