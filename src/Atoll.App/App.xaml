             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml" />
                <ResourceDictionary Source="Theme/Indicators.xaml" />
                <ResourceDictionary Source="Modules/Claude/ClaudeTemplates.xaml" />
                <ResourceDictionary Source="Modules/Providers/ProviderTemplates.xaml" />
