<Application x:Class="Atoll.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml" />
                <ResourceDictionary Source="Theme/Indicators.xaml" />
                <ResourceDictionary Source="Modules/Claude/ClaudeTemplates.xaml" />
                <ResourceDictionary Source="Modules/Clock/ClockTemplates.xaml" />
                <ResourceDictionary Source="Modules/Media/MediaTemplates.xaml" />
                <ResourceDictionary Source="Modules/Indicators/IndicatorsTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
