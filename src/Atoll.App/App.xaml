                <ResourceDictionary Source="Modules/Clipboard/ClipboardTemplates.xaml" />
                <ResourceDictionary Source="Modules/Stats/StatsTemplates.xaml" />
                <ResourceDictionary Source="Modules/Weather/WeatherTemplates.xaml" />
                <ResourceDictionary Source="Modules/Indicators/IndicatorsTemplates.xaml" />
                <ResourceDictionary Source="Modules/Calendar/CalendarTemplates.xaml" />
                <ResourceDictionary Source="Modules/Privacy/PrivacyTemplates.xaml" />
                <ResourceDictionary Source="Modules/Games/GamesTemplates.xaml" />
                <ResourceDictionary Source="Modules/Launcher/LauncherTemplates.xaml" />
                <ResourceDictionary Source="Modules/Notes/NotesTemplates.xaml" />
                <ResourceDictionary Source="Modules/Tide/TideTemplates.xaml" />
                <ResourceDictionary Source="Modules/Home/HomeTemplates.xaml" />
                <ResourceDictionary Source="Modules/GroupedTemplates.xaml" />
                <ResourceDictionary Source="Updates/UpdateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
