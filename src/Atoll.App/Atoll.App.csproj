<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by packaging\make-logos.py; also used for the tray icon (see TrayIcon). -->
    <ApplicationIcon>..\..\packaging\identity\Assets\Atoll.ico</ApplicationIcon>
    <AssemblyName>Atoll</AssemblyName>
    <RootNamespace>Atoll</RootNamespace>
    <!-- Custom entry point (Program.cs) so VelopackApp.Build().Run() runs before WPF starts. -->
    <StartupObject>Atoll.Program</StartupObject>
    <!-- Display name (Task Manager, file properties). Code and file names use "Atoll". -->
    <Product>ATOLL</Product>
    <AssemblyTitle>ATOLL</AssemblyTitle>
    <!-- WPF0001: Fluent ThemeMode is marked experimental; used only by the settings window. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml stays a resource container but must not generate a Main (Program.cs owns it). -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atoll.Tests" />
    <!-- Window icon for the settings window's taskbar button. -->
    <Resource Include="..\..\packaging\identity\Assets\Atoll.ico" Link="Assets\Atoll.ico" />
    <Content Include="..\..\packaging\setup-identity.ps1" Link="NotificationSetup\setup-identity.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\packaging\out\AtollDev.cer" Link="NotificationSetup\out\AtollDev.cer" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\packaging\out\AtollDev.cer')" />
    <Content Include="..\..\packaging\out\Atoll.Identity.msix" Link="NotificationSetup\out\Atoll.Identity.msix" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\..\packaging\out\Atoll.Identity.msix')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atoll.Core\Atoll.Core.csproj" />
    <!-- Builds the hook exe and copies it next to Island.exe; the app does not call its code. -->
    <ProjectReference Include="..\Atoll.ClaudeHook\Atoll.ClaudeHook.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel for the local provider gateway; its assemblies load only when the gateway is switched on. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Ical.Net" Version="5.2.4" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
