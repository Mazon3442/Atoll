<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Atoll</AssemblyName>
    <RootNamespace>Atoll</RootNamespace>
    <!-- WPF0001: Fluent ThemeMode is marked experimental; used only by the settings window. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Atoll.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\ClaudeHookProtocol.cs" Link="Shared\ClaudeHookProtocol.cs" />
    <!-- Builds the hook exe and copies it next to Island.exe; the app does not call its code. -->
    <ProjectReference Include="..\Atoll.ClaudeHook\Atoll.ClaudeHook.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

</Project>
