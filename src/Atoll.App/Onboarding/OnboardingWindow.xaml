<Window x:Class="Atoll.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Atoll.Shell"
        Title="Welcome to ATOLL" Width="900" Height="660" MinWidth="760" MinHeight="600"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterScreen" Icon="/Atoll;component/Assets/Atoll.ico"
        ThemeMode="System">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Atoll;component/Theme/Scrollbars.xaml" />
                <ResourceDictionary Source="/Atoll;component/Theme/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource Atoll.ScrollBar}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="OnboardingFocus" TargetType="Control">
                <Setter Property="Template"><Setter.Value><ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="14" Margin="-3" />
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Primary" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="22,9" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.9" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.75" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="Link" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="14" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Star marker: outline at rest, filled and accented when the tab is in the top row. -->
            <Style x:Key="BookmarkStar" TargetType="ToggleButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" CornerRadius="14" Background="Transparent">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="Outline" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="Filled" Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Filled" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.75" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- On/off switch for Start with Windows. -->
            <Style x:Key="Toggle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                                <TextBlock x:Name="State" Text="Off" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="22" />
                                <Border x:Name="Track" Width="40" Height="20" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static shell:PillRadius.Instance}}" BorderThickness="1"
                                        BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" Background="Transparent">
                                    <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0"
                                             Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="State" Property="Text" Value="On" />
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Knob" Property="Width" Value="14" />
                                    <Setter TargetName="Knob" Property="Height" Value="14" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.75" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="ContentRoot" Margin="44,30,44,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Width="30" Height="30" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Image Source="{StaticResource Atoll.Logo}" />
            </Border>
            <TextBlock Text="ATOLL" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <!-- Welcome: the island itself is the hero, not a row of feature cards. -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                    Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
            <Border CornerRadius="22" Height="196" Background="#0A0A0D" BorderBrush="#26262D" BorderThickness="1"
                    AutomationProperties.Name="ATOLL island preview">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Height="46" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static shell:PillRadius.Instance}}" Background="#151519" BorderBrush="#303038" BorderThickness="1" Padding="8,0,14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="14" Background="#25252C">
                                    <shell:Icon Kind="music" Size="14" Foreground="#ECECF1" />
                                </Border>
                                <StackPanel Margin="9,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="Now playing" FontSize="11" FontWeight="SemiBold" Foreground="#F4F4F7" />
                                    <TextBlock Text="Media" FontSize="11" Foreground="#8D8D96" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Rectangle Width="2" Height="8" RadiusX="1" RadiusY="1" Margin="1,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Rectangle Width="2" Height="14" RadiusX="1" RadiusY="1" Margin="1,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Rectangle Width="2" Height="10" RadiusX="1" RadiusY="1" Margin="1,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Rectangle Width="2" Height="17" RadiusX="1" RadiusY="1" Margin="1,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Rectangle Width="2" Height="6" RadiusX="1" RadiusY="1" Margin="1,0" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Height="34" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static shell:PillRadius.Instance}}" Background="#121216" BorderBrush="#2A2A31" BorderThickness="1"
                                Padding="11,0" Margin="7,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <shell:Icon Kind="timer" Size="12" Foreground="#D8D8DE" />
                                <TextBlock Text="Timer" FontSize="11" Foreground="#D8D8DE" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Height="34" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static shell:PillRadius.Instance}}" Background="#121216" BorderBrush="#2A2A31" BorderThickness="1"
                                Padding="11,0" Margin="6,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <shell:Icon Kind="cloud" Size="12" Foreground="#D8D8DE" />
                                <TextBlock Text="Weather" FontSize="11" Foreground="#D8D8DE" Margin="6,0,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="The island at the top edge" FontSize="11" Foreground="#787881"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="18,0,0,14" />
                </Grid>
            </Border>

            <TextBlock Text="Everything that's happening. One pill." FontSize="32" FontWeight="Light"
                       Margin="0,26,0,10" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Hint}" FontSize="14" MaxWidth="680" HorizontalAlignment="Left" TextAlignment="Left"
                       Text="ATOLL sits at the top edge of your screen. Hover to open your tabs. Move away and it folds back to the activity pill." />

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <StackPanel Orientation="Horizontal">
                        <shell:Icon Kind="activity" Size="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Live" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="12" LineHeight="17" Margin="0,6,0,0"
                               Text="Music, timers and calls share one pill." />
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="2" Margin="24,0">
                    <StackPanel Orientation="Horizontal">
                        <shell:Icon Kind="grid" Size="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Yours" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="12" LineHeight="17" Margin="0,6,0,0"
                               Text="Star tabs for the top row. The rest wait in the ⋯ menu." />
                </StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="4" Margin="24,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <shell:Icon Kind="lock" Size="15" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="On this PC" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" FontSize="12" LineHeight="17" Margin="0,6,0,0"
                               Text="Notes, files and settings never leave your machine." />
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Picker: a live island strip above one quiet list. -->
        <Grid Grid.Row="1" Visibility="{Binding IsPicker, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Pick your top row" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" MaxWidth="680" HorizontalAlignment="Left" TextAlignment="Left" Margin="0,6,0,0"
                           Text="Star the tabs you want at the top. Unstarred tabs stay on in the ⋯ menu, and you can change this any time in Settings › Modules." />
            </StackPanel>

            <Border Grid.Row="1" Height="86" CornerRadius="22" Background="#0A0A0D" BorderBrush="#26262D" BorderThickness="1"
                    Padding="16,0" Margin="0,0,0,14" AutomationProperties.Name="Top row preview">
                <Grid>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding TopRowPreview}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#17171C" BorderBrush="#303038" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static shell:PillRadius.Instance}}"
                                            Padding="10,7" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" Foreground="#ECECF1" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#F2F2F6"
                                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                    <TextBlock Text="Star a tab below to start the top row." FontSize="11" Foreground="#787881"
                               VerticalAlignment="Center" Margin="2,0,0,0"
                               Visibility="{Binding HasTopRow, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="4,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" FontSize="12" LineHeight="17" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" Style="{StaticResource BookmarkStar}" IsChecked="{Binding Bookmarked}"
                                                  VerticalAlignment="Center" ToolTip="Star for the top row"
                                                  AutomationProperties.Name="{Binding Name, StringFormat=Keep {0} in the top row}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Ready: confirm with the same island strip the user just built. -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                    Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Ready when you are." FontSize="32" FontWeight="Light" />
            <TextBlock Text="{Binding TopRowSummary}" FontSize="14" Style="{StaticResource Hint}" MaxWidth="620"
                       HorizontalAlignment="Left" TextAlignment="Left" Margin="0,8,0,18" />

            <Border CornerRadius="22" Background="#0A0A0D" BorderBrush="#26262D" BorderThickness="1"
                    Padding="18,16" AutomationProperties.Name="Your top row">
                <StackPanel>
                    <TextBlock Text="Your top row" FontSize="11" Foreground="#787881" Margin="0,0,0,10" />
                    <ItemsControl ItemsSource="{Binding TopRowPreview}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#17171C" BorderBrush="#303038" BorderThickness="1" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static shell:PillRadius.Instance}}"
                                        Padding="10,7" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#ECECF1" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#F2F2F6"
                                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No tabs starred. Everything stays in the ⋯ menu." FontSize="11" Foreground="#787881"
                               Visibility="{Binding HasTopRow, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="22" Padding="16,12" Margin="0,14,0,0">
                <DockPanel>
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}"
                              VerticalAlignment="Center" AutomationProperties.Name="Start ATOLL with Windows" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="Have ATOLL waiting when you sign in." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                       Text="Ctrl + Alt + Space opens the island anywhere. Esc closes it." />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,20,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StepLabel}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Use defaults" Style="{StaticResource Link}" Command="{Binding SkipCommand}"
                        Visibility="{Binding CanSkip, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Back" Style="{StaticResource Secondary}" Command="{Binding BackCommand}" Margin="6,0,0,0"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{Binding PrimaryLabel}" Style="{StaticResource Primary}" Command="{Binding PrimaryCommand}" Margin="8,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
