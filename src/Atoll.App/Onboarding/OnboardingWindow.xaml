<Window x:Class="Atoll.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Atoll.Shell"
        Title="Welcome to ATOLL" Width="880" Height="640" MinWidth="720" MinHeight="560"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterScreen" Icon="/Atoll;component/Assets/Atoll.ico"
        ThemeMode="System">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Atoll;component/Theme/Scrollbars.xaml" />
                <ResourceDictionary Source="/Atoll;component/Theme/Logo.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource Atoll.ScrollBar}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="OnboardingFocus" TargetType="Control">
                <Setter Property="Template"><Setter.Value><ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="7" Margin="-3" />
                </ControlTemplate></Setter.Value></Setter>
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="20" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="Primary" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="22,9" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.9" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.75" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource Primary}">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="Link" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The same on/off switch as Settings, sized for a card row. -->
            <Style x:Key="Toggle" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource OnboardingFocus}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                                <TextBlock x:Name="State" Text="Off" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="22" />
                                <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                        BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" Background="Transparent">
                                    <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0"
                                             Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="State" Property="Text" Value="On" />
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Knob" Property="Width" Value="14" />
                                    <Setter TargetName="Knob" Property="Height" Value="14" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.75" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="44,34,44,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Brand -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Border Width="30" Height="30" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Image Source="{StaticResource Atoll.Logo}" />
            </Border>
            <TextBlock Text="ATOLL" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>

        <!-- Welcome -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                    Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Your desktop, at a glance." FontSize="34" FontWeight="Light" />
            <TextBlock Style="{StaticResource Hint}" FontSize="15" LineHeight="23" MaxWidth="620" Margin="0,12,0,26"
                       HorizontalAlignment="Left" TextAlignment="Left"
                       Text="ATOLL is the pill at the top of your screen. It stays quiet until something is happening, then opens into the tabs you care about." />

            <Grid MaxWidth="700">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <shell:Icon Kind="activity" Size="20" HorizontalAlignment="Left" />
                        <TextBlock Text="Live, not loud" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Text="Music, timers, calls and downloads share the pill without taking over the screen." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <shell:Icon Kind="grid" Size="20" HorizontalAlignment="Left" />
                        <TextBlock Text="Your top row" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Text="Star the tabs you use; the rest wait in the ⋯ menu. Rearrange them in Settings." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <shell:Icon Kind="lock" Size="20" HorizontalAlignment="Left" />
                        <TextBlock Text="Yours only" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Text="Notes, clipboards and settings stay on this PC. Nothing is uploaded." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Top-row picker -->
        <Grid Grid.Row="1" Visibility="{Binding IsPicker, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Pick your top row" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Hint}" MaxWidth="680" Margin="0,6,0,0"
                           Text="Star a tab to keep it in the island's top row. Unstarred tabs stay available in the ⋯ menu, and you can change this any time in Settings › Modules." />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" FontSize="12" LineHeight="17" />
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" Style="{StaticResource Toggle}" IsChecked="{Binding Bookmarked}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{Binding Name, StringFormat=Keep {0} in the top row}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Ready -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                    Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
            <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Left"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="You're set." FontSize="32" FontWeight="Light" Margin="0,18,0,8" />
            <TextBlock Text="{Binding TopRowSummary}" FontSize="15" Style="{StaticResource Hint}" MaxWidth="600" Margin="0,0,0,22"
                       HorizontalAlignment="Left" TextAlignment="Left" />

            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="18" MaxWidth="620" HorizontalAlignment="Left">
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Start ATOLL with Windows" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12" Text="Have ATOLL waiting at the top of the screen when you sign in." />
                        </StackPanel>
                    </DockPanel>
                    <Border Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,14,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <shell:Icon Kind="settings" Size="18" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Text="Everything else lives in Settings, from the island's ⋯ menu or by right-clicking the tray icon." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0"
                       Text="Tip: Ctrl + Alt + Space opens the island anywhere. Esc closes it." />
        </StackPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,22,0,0">
            <TextBlock DockPanel.Dock="Left" Text="{Binding StepLabel}" Style="{StaticResource Hint}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Skip" Style="{StaticResource Link}" Command="{Binding SkipCommand}"
                        Visibility="{Binding CanSkip, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Back" Style="{StaticResource Secondary}" Command="{Binding BackCommand}" Margin="6,0,0,0"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Continue" Style="{StaticResource Primary}" Command="{Binding NextCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsReady, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                <Button Content="Get started" Style="{StaticResource Primary}" Command="{Binding FinishCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
