<UserControl x:Class="Atoll.Shell.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Command palette">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource Island.Surface}" CornerRadius="12" Padding="12,6" Margin="0,0,0,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Text="Esc" FontSize="11" Foreground="{DynamicResource Island.Subtle}"
                           VerticalAlignment="Center" Margin="10,0,2,0" />
                <Grid Margin="10,0,8,0">
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="14"
                             Foreground="{DynamicResource Island.Foreground}" CaretBrush="{DynamicResource Island.Foreground}"
                             VerticalContentAlignment="Center" Height="30"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnSearchKeyDown" AutomationProperties.Name="Search tabs, apps and actions" />
                    <TextBlock Text="Search tabs, apps and actions" FontSize="14" Margin="2,0,0,0" IsHitTestVisible="False"
                               Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Query}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource Island.TabMenuItem}"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource Island.Foreground}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     KeyDown="OnResultsKeyDown" MouseLeftButtonUp="OnResultClick"
                     AutomationProperties.Name="Commands">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="7"
                                    Background="{DynamicResource Island.Hover}" Margin="0,0,10,0">
                                <Grid>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Island.Foreground}"
                                               Visibility="{Binding ShowGlyph, Converter={StaticResource Island.BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Island.Foreground}"
                                               Visibility="{Binding ShowInitial, Converter={StaticResource Island.BoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11"
                                       Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" Margin="10,0,2,0" />
                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No tabs, apps or actions match." FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Island.Subtle}"
                       Visibility="{Binding HasResults, Converter={StaticResource Island.InverseBoolToVisibility}}" />
        </Grid>
    </Grid>
</UserControl>
