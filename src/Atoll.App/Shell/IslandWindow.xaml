<Window x:Class="Atoll.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Atoll.Shell"
        Title="ATOLL"
        Width="760" Height="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource Island.Font}"
        Foreground="{DynamicResource Island.Foreground}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Transparent pixels pass mouse input through to whatever is underneath. -->
    <Grid x:Name="Stage" VerticalAlignment="Top" HorizontalAlignment="Center">

        <shell:PillBorder x:Name="Pill"
                          Background="{DynamicResource Island.Background}" BorderBrush="{DynamicResource Island.Rim}" BorderThickness="1"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          ClipToBounds="True"
                          AutomationProperties.Name="ATOLL">
            <Grid>
                <ContentPresenter x:Name="PillContent"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Grid x:Name="PanelRoot" Visibility="Collapsed" Margin="14,10,14,14"
                      HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel x:Name="Header" Background="Transparent" MouseWheel="OnHeaderWheel">
                        <!-- Status chips: battery, mic, sound, lock, settings. DataContext: the System group (null when it is off). -->
                        <StackPanel x:Name="StatusChips" DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource Island.RoundButton}">
                                    <Setter Property="Margin" Value="5,0,0,0" />
                                    <Setter Property="Width" Value="34" />
                                    <Setter Property="Height" Value="34" />
                                </Style>
                            </StackPanel.Resources>
                            <!-- One Status chip: battery, Focus and mic when on, Bluetooth and network. Click opens the status card. -->
                            <Button x:Name="StatusButton" Width="Auto" Click="OnStatusClick" ToolTip="Status" AutomationProperties.Name="Status"
                                    Visibility="{Binding Devices, Converter={x:Static shell:NotNullToVisibility.Instance}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                                Visibility="{Binding Devices.ShowBatteryChip, Converter={StaticResource Island.BoolToVisibility}, FallbackValue=Collapsed}">
                                        <shell:Icon Kind="battery" Size="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Devices.BatteryShort}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Devices.BatteryLow}" Value="True">
                                                        <Setter Property="TextElement.Foreground" Value="#FF9F0A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                    </StackPanel>
                                    <shell:Icon x:Name="StatusFocusIcon" Kind="moon" Size="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                                Foreground="{DynamicResource Island.Accent}" Visibility="Collapsed" />
                                    <shell:Icon Kind="mic-off" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#FF453A"
                                                Visibility="{Binding Actions.MicMuted, Converter={StaticResource Island.BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <shell:Icon Kind="bluetooth" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Island.Subtle}"
                                                Visibility="{Binding Devices.HasBluetooth, Converter={StaticResource Island.BoolToVisibility}, FallbackValue=Collapsed}" />
                                    <shell:Icon Kind="wifi" Size="14" VerticalAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                                </StackPanel>
                            </Button>
                            <Popup x:Name="FocusPopup" PlacementTarget="{Binding ElementName=StatusButton}"
                                   Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource Island.Menu}" BorderBrush="{DynamicResource Island.Hover}"
                                        BorderThickness="1" CornerRadius="{shell:Round 22}" Padding="6" MinWidth="210">
                                    <StackPanel>
                                        <TextBlock x:Name="FocusPopupTitle" Text="Do Not Disturb" FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource Island.Subtle}" Margin="8,6,8,4" TextWrapping="Wrap" />
                                        <Button Style="{StaticResource Island.RowButton}" Content="For 30 minutes" Click="OnFocus30" />
                                        <Button Style="{StaticResource Island.RowButton}" Content="For 1 hour" Click="OnFocus60" />
                                        <Button Style="{StaticResource Island.RowButton}" Content="For 2 hours" Click="OnFocus120" />
                                        <Button Style="{StaticResource Island.RowButton}" Content="Until tomorrow" Click="OnFocusTomorrow" />
                                        <Button x:Name="FocusOffButton" Style="{StaticResource Island.RowButton}" Content="Turn off focus"
                                                Click="OnFocusOff" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Popup x:Name="StatusPopup" PlacementTarget="{Binding ElementName=StatusButton}"
                                   Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" DataContext="{Binding DataContext, ElementName=StatusChips}">
                                <Border Background="{DynamicResource Island.Menu}" BorderBrush="{DynamicResource Island.Hover}"
                                        BorderThickness="1" CornerRadius="{shell:Round 22}" Padding="8" Width="340">
                                    <StackPanel>
                                        <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Padding="12" Margin="0,0,0,8"
                                                Visibility="{Binding Devices.HasBattery, Converter={StaticResource Island.BoolToVisibility}, FallbackValue=Collapsed}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Devices.BatteryShort}" FontSize="24" FontWeight="Light" />
                                                    <shell:Icon Kind="battery" Size="16" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                    <TextBlock Text="Battery" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Devices.BatteryPercent, Mode=OneWay}" Height="6" Margin="0,8,0,6" Foreground="{DynamicResource Island.Foreground}">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid>
                                                                <Border Background="{DynamicResource Island.Raised}" CornerRadius="3" />
                                                                <Border x:Name="PART_Track">
                                                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3" />
                                                                </Border>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                                <TextBlock Text="{Binding Devices.Battery}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel>
                                                    <shell:Icon Kind="bluetooth" Size="16" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                    <TextBlock Text="Bluetooth" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Devices.Bluetooth}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                                <ItemsControl ItemsSource="{Binding Stats.Devices}" Focusable="False" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="0,3" AutomationProperties.Name="{Binding Description}">
                                                                <TextBlock x:Name="Level" DockPanel.Dock="Right" Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
                                                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                                    <Setter TargetName="Level" Property="Foreground" Value="#FF9F0A" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Padding="12" Margin="0,0,0,8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Devices.Network}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
                                                <shell:Icon Kind="wifi" Size="16" DockPanel.Dock="Left" VerticalAlignment="Center" />
                                                <TextBlock Text="Network" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <UniformGrid Columns="4" Margin="0,0,-8,0">
                                            <Button x:Name="FocusTile" Style="{StaticResource System.ActionTile}" Margin="0,0,8,0" Click="OnFocusTileClick" AutomationProperties.Name="Do Not Disturb">
                                                <StackPanel>
                                                    <shell:Icon Kind="moon" Size="16" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Focus" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource System.ActionTile}" Margin="0,0,8,0" Command="{Binding Actions.ToggleMicCommand}" AutomationProperties.Name="Mute or unmute the microphone">
                                                <StackPanel>
                                                    <shell:Icon Size="16" HorizontalAlignment="Center">
                                                        <shell:Icon.Style>
                                                            <Style TargetType="shell:Icon">
                                                                <Setter Property="Kind" Value="mic" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Actions.MicMuted}" Value="True"><Setter Property="Kind" Value="mic-off" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </shell:Icon.Style>
                                                    </shell:Icon>
                                                    <TextBlock Text="Mic" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource System.ActionTile}" Margin="0,0,8,0" Command="{Binding Devices.ToggleMuteCommand}" AutomationProperties.Name="Mute or unmute sound">
                                                <StackPanel>
                                                    <shell:Icon Size="16" HorizontalAlignment="Center">
                                                        <shell:Icon.Style>
                                                            <Style TargetType="shell:Icon">
                                                                <Setter Property="Kind" Value="volume" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Devices.IsMuted}" Value="True"><Setter Property="Kind" Value="volume-off" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </shell:Icon.Style>
                                                    </shell:Icon>
                                                    <TextBlock Text="Mute" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource System.ActionTile}" Margin="0,0,8,0" Command="{Binding Actions.LockCommand}" AutomationProperties.Name="Lock the PC">
                                                <StackPanel>
                                                    <shell:Icon Kind="lock" Size="16" HorizontalAlignment="Center" />
                                                    <TextBlock Text="Lock" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button Width="Auto" ToolTip="Search tabs, apps and actions (Ctrl+K)" AutomationProperties.Name="Search" Click="OnPaletteClick">
                                <StackPanel Orientation="Horizontal" Margin="12,0">
                                    <shell:Icon Kind="search" Size="14" Foreground="{DynamicResource Island.Subtle}" />
                                    <TextBlock Text="Ctrl K" FontSize="12" Foreground="{DynamicResource Island.Subtle}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button ToolTip="Settings" AutomationProperties.Name="Settings" Click="OnSettingsClick">
                                <shell:Icon Kind="settings" Size="15" />
                            </Button>
                        </StackPanel>
                        <Border x:Name="TabStrip" Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round}" Padding="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ListBox x:Name="Tabs"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource Island.TabItem}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="ATOLL sections">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Descriptor.Name}"
                                                        AutomationProperties.Name="{Binding Descriptor.Name}">
                                                <shell:Icon Kind="{Binding Descriptor.Id, Converter={x:Static shell:TabIconConverter.Instance}}" Size="15" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Descriptor.Name}" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource Island.BoolToVisibility}, FallbackValue=Collapsed}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="TabMenuButton" Style="{StaticResource Island.IconButton}" Width="34" Height="34"
                                        Margin="2,0,0,0" Click="OnTabMenuClick" ToolTip="Sections outside the top row"
                                        Visibility="Collapsed" AutomationProperties.Name="Sections outside the top row">
                                    <shell:Icon Kind="more" Size="15" />
                                </Button>
                                <Popup x:Name="TabMenuPopup" PlacementTarget="{Binding ElementName=TabMenuButton}"
                                       Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                       PopupAnimation="Fade" Opened="OnTabMenuOpened">
                                    <Border Background="{DynamicResource Island.Menu}" BorderBrush="{DynamicResource Island.Hover}"
                                            BorderThickness="1" CornerRadius="{shell:Round 22}" Padding="4" MinWidth="200" MaxHeight="360">
                                        <StackPanel>
                                            <TextBlock Text="Outside the top row" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource Island.Subtle}" Margin="8,6,8,4" />
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <ListBox x:Name="TabMenu"
                                                         ItemContainerStyle="{StaticResource Island.TabMenuItem}"
                                                         Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource Island.Foreground}"
                                                         KeyDown="OnTabMenuKeyDown" MouseLeftButtonUp="OnTabMenuClickItem"
                                                         AutomationProperties.Name="Sections outside the top row">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Style="{StaticResource Island.IconButton}"
                                                                        Width="24" Height="24" Margin="6,0,0,0"
                                                                        Click="OnTabMenuBookmark" ToolTip="Keep in the top row"
                                                                        AutomationProperties.Name="{Binding Descriptor.Name, StringFormat=Keep {0} in the top row}">
                                                                    <shell:Icon Kind="pin" Size="12" />
                                                                </Button>
                                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Descriptor.Glyph}"
                                                                           FontFamily="{StaticResource Island.IconFont}" FontSize="15"
                                                                           Margin="0,0,9,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Descriptor.Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="4,10,4,0">
                        <ContentPresenter x:Name="PanelBody" />
                        <shell:CommandPaletteView x:Name="Palette" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Grid>
        </shell:PillBorder>

        <shell:PillBorder x:Name="Bubble"
                          Background="{DynamicResource Island.Background}" BorderBrush="{DynamicResource Island.Rim}" BorderThickness="1"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Cursor="Hand"
                          AutomationProperties.Name="Secondary activity">
            <shell:PillBorder.RenderTransform>
                <TranslateTransform x:Name="BubbleShift" />
            </shell:PillBorder.RenderTransform>
            <ContentPresenter x:Name="BubbleContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </shell:PillBorder>
        <shell:PillBorder x:Name="Bubble2"
                          Background="{DynamicResource Island.Background}" BorderBrush="{DynamicResource Island.Rim}" BorderThickness="1"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Cursor="Hand"
                          AutomationProperties.Name="Third activity">
            <shell:PillBorder.RenderTransform>
                <TranslateTransform x:Name="Bubble2Shift" />
            </shell:PillBorder.RenderTransform>
            <ContentPresenter x:Name="Bubble2Content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </shell:PillBorder>
        <shell:PillBorder x:Name="Bubble3"
                          Background="{DynamicResource Island.Background}" BorderBrush="{DynamicResource Island.Rim}" BorderThickness="1"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Cursor="Hand"
                          AutomationProperties.Name="Third side activity">
            <shell:PillBorder.RenderTransform>
                <TranslateTransform x:Name="Bubble3Shift" />
            </shell:PillBorder.RenderTransform>
            <ContentPresenter x:Name="Bubble3Content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </shell:PillBorder>
        <shell:PillBorder x:Name="Bubble4"
                          Background="{DynamicResource Island.Background}" BorderBrush="{DynamicResource Island.Rim}" BorderThickness="1"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Cursor="Hand"
                          AutomationProperties.Name="Fourth side activity">
            <shell:PillBorder.RenderTransform>
                <TranslateTransform x:Name="Bubble4Shift" />
            </shell:PillBorder.RenderTransform>
            <ContentPresenter x:Name="Bubble4Content" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </shell:PillBorder>
    </Grid>
</Window>
