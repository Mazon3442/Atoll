<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell"
                    x:Class="Atoll.Modules.Tide.TideTemplates">

    <DataTemplate x:Key="TideViewModel.Panel">
        <DataTemplate.Resources>
            <Style x:Key="Tide.Chip" TargetType="Button" BasedOn="{StaticResource Island.ChipButton}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="2" />
            </Style>
            <!-- A script in the list: document icon, title, and a delete button that appears on hover. -->
            <Style x:Key="Tide.ScriptRow" TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="{shell:Round 14}" Padding="8,6" Margin="0,0,0,2">
                                <DockPanel>
                                    <Button x:Name="Remove" DockPanel.Dock="Right" Style="{StaticResource Island.IconButton}"
                                            Width="22" Height="22" Opacity="0" Margin="4,0,0,0"
                                            Command="{Binding DataContext.DeleteScriptCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}" ToolTip="Delete this script"
                                            AutomationProperties.Name="{Binding Title, StringFormat=Delete {0}}">
                                        <shell:Icon Kind="trash" Size="13" />
                                    </Button>
                                    <shell:Icon DockPanel.Dock="Left" Kind="file-text" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                                    <Setter TargetName="Remove" Property="Opacity" Value="0.8" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Raised}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                                    <Setter TargetName="Remove" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The one filled button: starts, pauses and resumes. -->
            <Style x:Key="Tide.Primary" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{DynamicResource Island.Accent}" CornerRadius="{shell:Round}" Padding="16,0" Height="32"
                                    TextElement.Foreground="White">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <shell:Icon Size="13" VerticalAlignment="Center">
                                        <shell:Icon.Style>
                                            <Style TargetType="shell:Icon">
                                                <Setter Property="Kind" Value="play" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PrimaryIsPause}" Value="True">
                                                        <Setter Property="Kind" Value="pause" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </shell:Icon.Style>
                                    </shell:Icon>
                                    <TextBlock Text="{Binding PrimaryLabel}" FontSize="13" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Tide.RoundToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" CornerRadius="{shell:Round}" Background="{DynamicResource Island.Surface}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Raised}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Island.Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Transcript rows are read, not chosen: no selection highlight, but the list keeps keyboard scrolling. -->
            <Style x:Key="Tide.TranscriptRow" TargetType="ListBoxItem">
                <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="4,3" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="{shell:Round}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Tide.ListenLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
                <Setter Property="Margin" Value="0,6,0,2" />
            </Style>
            <Style x:Key="Tide.Toggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bg" Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round}" Padding="8,3"
                                    BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                                </Trigger>
                                <!-- On is a filled chip with an accent ring, so the state reads as on, not as bold text. -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Raised}" />
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Island.Accent}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </DataTemplate.Resources>
        <StackPanel MinHeight="250">
            <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round}" Padding="3"
                    HorizontalAlignment="Left" Margin="0,0,0,8">
                <ListBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource Island.SegmentItem}"
                         Background="Transparent" BorderThickness="0" FontSize="12"
                         Foreground="{DynamicResource Island.Subtle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Tide section">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <!-- Scripts: the list on the left, the script on the right. -->
            <StackPanel Visibility="{Binding IsScripts, Converter={StaticResource Island.BoolToVisibility}}">
                <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="{shell:Round 22}" Background="{DynamicResource Island.Surface}"
                        Visibility="{Binding ShowCaptureBanner, Converter={StaticResource Island.BoolToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Tide.Chip}" Content="Hide" FontWeight="SemiBold"
                                Foreground="{DynamicResource Island.Accent}" Command="{Binding HideNowCommand}" Margin="12,0,0,0"
                                AutomationProperties.Name="Hide ATOLL from screen capture" />
                        <shell:Icon DockPanel.Dock="Left" Kind="eye" Size="16" Foreground="{DynamicResource Island.Accent}"
                                    Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Your audience can see ATOLL" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="Hide it from screen capture so Zoom, Meet and OBS can't see your script." FontSize="11"
                                       Foreground="{DynamicResource Island.Subtle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid Height="190">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,10,0">
                        <DockPanel DockPanel.Dock="Top" Margin="8,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Island.IconButton}" Width="24" Height="24"
                                    Command="{Binding NewScriptCommand}" ToolTip="New script" AutomationProperties.Name="New script">
                                <shell:Icon Kind="plus" Size="15" />
                            </Button>
                            <TextBlock Text="Scripts" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Island.Subtle}" />
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource Tide.ScriptRow}"
                                 Background="Transparent" BorderThickness="0" FontSize="13"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Scripts">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <Border Grid.Column="1" Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 22}" Padding="14,10">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Top" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0,0,0,6" FontSize="14" FontWeight="SemiBold"
                                     Foreground="{DynamicResource Island.Foreground}" CaretBrush="{DynamicResource Island.Foreground}"
                                     AutomationProperties.Name="Script title" />
                            <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0" FontSize="14"
                                     Foreground="{DynamicResource Island.Foreground}" CaretBrush="{DynamicResource Island.Foreground}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Script body" />
                        </DockPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Prompter: the script under the camera. The sentence at the reading line is brightest; the rest fades. -->
            <Grid Visibility="{Binding IsPrompter, Converter={StaticResource Island.BoolToVisibility}}" Height="262">
                <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 22}" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="PromptScroll" VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled" Focusable="True" Cursor="Hand"
                                      Loaded="OnPromptLoaded" Unloaded="OnPromptUnloaded"
                                      PreviewMouseWheel="OnPromptWheel" ScrollChanged="OnPromptScroll"
                                      AutomationProperties.Name="Teleprompter">
                            <ScrollViewer.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding TogglePauseCommand}" />
                            </ScrollViewer.InputBindings>
                            <ScrollViewer.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#33000000" Offset="0" />
                                    <GradientStop Color="#66000000" Offset="0.2" />
                                    <GradientStop Color="#FF000000" Offset="0.34" />
                                    <GradientStop Color="#FF000000" Offset="0.5" />
                                    <GradientStop Color="#80000000" Offset="0.72" />
                                    <GradientStop Color="#33000000" Offset="1" />
                                </LinearGradientBrush>
                            </ScrollViewer.OpacityMask>
                            <TextBlock x:Name="PromptText" Text="{Binding Body}" FontSize="{Binding FontSize}"
                                       LineHeight="{Binding PrompterLineHeight}" LineStackingStrategy="BlockLineHeight"
                                       MaxWidth="560" Foreground="{DynamicResource Island.Foreground}"
                                       TextWrapping="Wrap" Margin="0,92,0,120" HorizontalAlignment="Center"
                                       TextAlignment="Center" RenderTransformOrigin="0.5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><ScaleTransform ScaleX="1" /></Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Mirror}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value><ScaleTransform ScaleX="-1" /></Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ScrollViewer>

                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="{shell:Round}" Padding="12,5"
                                Background="{DynamicResource Island.Raised}" IsHitTestVisible="False"
                                Visibility="{Binding IsPaused, Converter={StaticResource Island.BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <shell:Icon Kind="pause" Size="12" VerticalAlignment="Center" />
                                <TextBlock Text="Paused" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <Border Background="{DynamicResource Island.Raised}" CornerRadius="{shell:Round}" Padding="2" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Island.IconButton}" Width="26" Height="26" Command="{Binding SmallerTextCommand}"
                                            ToolTip="Smaller text" AutomationProperties.Name="Smaller text">
                                        <shell:Icon Kind="minus" Size="13" />
                                    </Button>
                                    <TextBlock Text="{Binding FontLabel}" FontSize="12" FontWeight="SemiBold" MinWidth="22" TextAlignment="Center"
                                               VerticalAlignment="Center" AutomationProperties.Name="Text size" />
                                    <Button Style="{StaticResource Island.IconButton}" Width="26" Height="26" Command="{Binding LargerTextCommand}"
                                            ToolTip="Larger text" AutomationProperties.Name="Larger text">
                                        <shell:Icon Kind="plus" Size="13" />
                                    </Button>
                                    <ToggleButton Style="{StaticResource Tide.Toggle}" Content="Mirror" IsChecked="{Binding Mirror}"
                                                  Margin="4,0,0,0" ToolTip="Flip the text for a glass prompter"
                                                  AutomationProperties.Name="Mirror the script" />
                                    <ToggleButton Style="{StaticResource Tide.RoundToggle}" Width="26" Height="26" IsChecked="{Binding HideFromCapture}"
                                                  Margin="4,0,0,0" ToolTip="{Binding CaptureHint}"
                                                  AutomationProperties.Name="Hide from screen capture">
                                        <shell:Icon Size="14">
                                            <shell:Icon.Style>
                                                <Style TargetType="shell:Icon">
                                                    <Setter Property="Kind" Value="eye" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HideFromCapture}" Value="True">
                                                            <Setter Property="Kind" Value="eye-off" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </shell:Icon.Style>
                                        </shell:Icon>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>
                            <Button Width="30" Height="30" Command="{Binding StopPrompterCommand}" ToolTip="Stop and go back to the script"
                                    AutomationProperties.Name="Stop the prompter" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" CornerRadius="{shell:Round}" Background="#E5484D">
                                            <Rectangle Width="9" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- One bar for both: reading speed on the left, voice follow and the main button on the right. -->
            <Grid Margin="0,10,0,0" Visibility="{Binding ShowsPrompterBar, Converter={StaticResource Island.BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Padding="3" VerticalAlignment="Center">
                    <ListBox ItemsSource="{Binding Speeds}" SelectedIndex="{Binding SpeedIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Island.SegmentItem}"
                             Background="Transparent" BorderThickness="0" FontSize="12"
                             Foreground="{DynamicResource Island.Subtle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Reading speed">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Tide.RoundToggle}" IsChecked="{Binding FollowVoice}" Margin="0,0,8,0"
                                  ToolTip="Follow my voice" AutomationProperties.Name="Follow my voice">
                        <shell:Icon Size="15">
                            <shell:Icon.Style>
                                <Style TargetType="shell:Icon">
                                    <Setter Property="Kind" Value="mic-off" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FollowVoice}" Value="True">
                                            <Setter Property="Kind" Value="mic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </shell:Icon.Style>
                        </shell:Icon>
                    </ToggleButton>
                    <Button Style="{StaticResource Tide.Primary}" Command="{Binding PrimaryCommand}"
                            AutomationProperties.Name="Start or pause the prompter" />
                </StackPanel>
            </Grid>

            <!-- Listen: local mic + system audio, a speaker-labelled transcript, notes and suggested replies. -->
            <Grid Visibility="{Binding IsListen, Converter={StaticResource Island.BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Command="{Binding Listen.ToggleCommand}"
                            ToolTip="Capture the microphone and the call, then transcribe locally">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Island.ChipButton}">
                                <Setter Property="Content" Value="Listen" />
                                <Setter Property="AutomationProperties.Name" Value="Start listening" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="MinHeight" Value="30" />
                                <Setter Property="MinWidth" Value="82" />
                                <Setter Property="Margin" Value="2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Listen.IsListening}" Value="True">
                                        <Setter Property="Content" Value="Stop" />
                                        <Setter Property="AutomationProperties.Name" Value="Stop listening" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Listen.IsPreparing}" Value="True">
                                        <Setter Property="Content" Value="Cancel" />
                                        <Setter Property="AutomationProperties.Name" Value="Cancel starting Listen" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <ToggleButton Style="{StaticResource Tide.Toggle}" Content="Microphone"
                                      IsChecked="{Binding Listen.CaptureMic}" IsEnabled="{Binding Listen.CanChangeCapture}"
                                      ToolTip="Your side of the call, labelled You"
                                      AutomationProperties.Name="Capture the microphone" />
                        <ToggleButton Style="{StaticResource Tide.Toggle}" Content="System audio"
                                      IsChecked="{Binding Listen.CaptureSystem}" IsEnabled="{Binding Listen.CanChangeCapture}"
                                      ToolTip="The other participants, labelled Others"
                                      AutomationProperties.Name="Capture system audio" />
                        <Button Style="{StaticResource Tide.Chip}" Content="Sessions"
                                Command="{Binding Listen.OpenSessionsCommand}"
                                ToolTip="Open the folder of saved sessions" AutomationProperties.Name="Open saved sessions" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding Listen.Status}" FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150"
                               ToolTip="{Binding Listen.StatusDetail}" />
                </Grid>

                <Grid Grid.Row="1" Height="210">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 22}" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Transcribing" FontSize="11" Foreground="{DynamicResource Island.Accent}"
                                           DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Visibility="{Binding Listen.IsTranscribing, Converter={StaticResource Island.BoolToVisibility}}" />
                                <TextBlock Text="Transcript" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="ListenTranscript" ItemsSource="{Binding Listen.Transcript}"
                                         ItemContainerStyle="{StaticResource Tide.TranscriptRow}"
                                         Background="Transparent" BorderThickness="0" FontSize="12"
                                         Foreground="{DynamicResource Island.Subtle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         Loaded="OnTranscriptLoaded" Unloaded="OnTranscriptUnloaded"
                                         AutomationProperties.Name="Meeting transcript">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Speaker}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsYou}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Island.Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="11"
                                                               Foreground="{DynamicResource Island.Subtle}" Opacity="0.7" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Island.Foreground}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 22}" Padding="8,6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <TextBlock Text="Updating" FontSize="11" Foreground="{DynamicResource Island.Accent}"
                                           DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Visibility="{Binding Listen.NotesBusy, Converter={StaticResource Island.BoolToVisibility}}" />
                                <TextBlock Text="Notes" FontSize="11" FontWeight="SemiBold" />
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Listen.NotesStatus}" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource Island.Subtle}" />
                                    <!-- No model is a clear state with a way out, not a silent empty pane. -->
                                    <Border Background="{DynamicResource Island.Raised}" CornerRadius="{shell:Round 14}" Padding="7,5" Margin="0,2,0,2"
                                            Visibility="{Binding Listen.NeedsNotesModel, Converter={StaticResource Island.BoolToVisibility}}">
                                        <StackPanel>
                                            <TextBlock Text="Notes need a model. Start Ollama, or add a provider key in Settings."
                                                       TextWrapping="Wrap" FontSize="11" />
                                            <Button Style="{StaticResource Tide.Chip}" Content="Settings" HorizontalAlignment="Left"
                                                    Command="{Binding Listen.OpenNotesSettingsCommand}"
                                                    AutomationProperties.Name="Open notes model settings" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Style="{StaticResource Tide.ListenLabel}" Text="SUMMARY" />
                                    <TextBlock Text="{Binding Listen.Summary}" TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource Island.Foreground}" />

                                    <TextBlock Style="{StaticResource Tide.ListenLabel}" Text="ACTION ITEMS" />
                                    <ItemsControl ItemsSource="{Binding Listen.ActionItems}" AutomationProperties.Name="Action items">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <TextBlock Text="{Binding OwnerText}" FontSize="11" DockPanel.Dock="Right"
                                                               Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource Tide.ListenLabel}" Text="SUGGESTED REPLIES" />
                                    <ItemsControl ItemsSource="{Binding Listen.Replies}" AutomationProperties.Name="Suggested replies">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,1">
                                                    <TextBlock Text="{Binding Tone}" FontSize="11" DockPanel.Dock="Right"
                                                               Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="11" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2">
                                <TextBox Style="{StaticResource Island.Input}" Text="{Binding Listen.NotesText, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="56" FontSize="11"
                                         VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Meeting notes" ToolTip="Your notes for this session" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="1.1*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Style="{StaticResource Island.Picker}" Height="26" FontSize="11"
                                              ItemsSource="{Binding Listen.NotesSources}" SelectedItem="{Binding Listen.NotesSource, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              AutomationProperties.Name="Notes source"
                                              ToolTip="Automatic prefers a local Ollama, then your provider keys" />
                                    <TextBox Grid.Column="2" Style="{StaticResource Island.Input}" FontSize="11" Height="26"
                                             Text="{Binding Listen.NotesModel, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Notes model"
                                             ToolTip="Ollama model. Blank uses the first installed model." />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Listen.ModelProgress}"
                                 Background="{DynamicResource Island.Surface}" Foreground="{DynamicResource Island.Accent}"
                                 BorderThickness="0" VerticalAlignment="Center"
                                 Visibility="{Binding Listen.IsDownloadingModel, Converter={StaticResource Island.BoolToVisibility}}"
                                 AutomationProperties.Name="Speech model download progress" />
                    <TextBlock Grid.Column="1" Text="{Binding Listen.StatusDetail}" FontSize="11"
                               Foreground="{DynamicResource Island.Subtle}" TextTrimming="CharacterEllipsis"
                               MaxWidth="360" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
            </Grid>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
