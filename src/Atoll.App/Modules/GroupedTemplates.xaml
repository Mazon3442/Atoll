<ResourceDictionary
    xmlns:shell="clr-namespace:Atoll.Shell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Group.Panel" TargetType="ContentControl">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="MediaPanelViewModel.Panel">
        <DockPanel>
            <!-- One slider: the playing app only, or all sound. The chip switches and is remembered. -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Island.ChipButton}" Margin="8,0,0,0" MaxWidth="140"
                        Command="{Binding Player.ToggleVolumeScopeCommand}" ToolTip="{Binding Player.VolumeScopeDescription}"
                        AutomationProperties.Name="{Binding Player.VolumeScopeDescription}"
                        Visibility="{Binding Player.HasAppVolume, Converter={StaticResource Island.BoolToVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding Player.VolumeScopeLabel}" TextTrimming="CharacterEllipsis" />
                </Button>
                <Grid>
                    <ContentControl Style="{StaticResource Group.Panel}" Content="{Binding Sound}" ContentTemplate="{StaticResource SystemPanelViewModel.Volume}"
                                    Visibility="{Binding Player.ShowsAppVolume, Converter={StaticResource Island.InverseBoolToVisibility}, FallbackValue=Visible}" />
                    <DockPanel Visibility="{Binding Player.ShowsAppVolume, Converter={StaticResource Island.BoolToVisibility}, FallbackValue=Collapsed}">
                        <TextBlock DockPanel.Dock="Left" Width="32" Text="&#xE767;" FontFamily="{StaticResource Island.IconFont}" FontSize="15"
                                   VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Player.AppVolume, StringFormat={}{0:0}%}" />
                        <Slider Style="{StaticResource Island.Slider}" Minimum="0" Maximum="100" Value="{Binding Player.AppVolume}"
                                Margin="10,0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Player.AppName, StringFormat={}{0} volume}" />
                    </DockPanel>
                </Grid>
            </DockPanel>
            <ContentControl Style="{StaticResource Group.Panel}" Content="{Binding Player}"
                            ContentTemplate="{StaticResource MediaViewModel.Panel}" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate x:Key="TimePanelViewModel.Panel">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ClockColumn" Width="1.05*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CalendarColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Style="{StaticResource Group.Panel}" Content="{Binding Clock}"
                                ContentTemplate="{StaticResource ClockPanelViewModel.Panel}" />
            </ScrollViewer>
            <Border x:Name="Divider" Grid.Column="1" Width="1" Margin="14,2" Background="{DynamicResource Island.Hover}" />
            <ContentControl Grid.Column="2" Style="{StaticResource Group.Panel}" Content="{Binding Calendar}"
                            ContentTemplate="{StaticResource CalendarViewModel.Panel}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Clock}" Value="{x:Null}">
                <Setter TargetName="ClockColumn" Property="Width" Value="0" />
                <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Calendar}" Value="{x:Null}">
                <Setter TargetName="CalendarColumn" Property="Width" Value="0" />
                <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="FilesPanelViewModel.Panel">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ShelfColumn" Width="*" />
                <ColumnDefinition x:Name="ClipboardColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel x:Name="ShelfSection" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="File shelf" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ContentControl Style="{StaticResource Group.Panel}" Content="{Binding Shelf}"
                                ContentTemplate="{StaticResource ShelfViewModel.Panel}" />
            </DockPanel>
            <DockPanel x:Name="ClipboardSection" Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" Text="Clipboard history" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ContentControl Style="{StaticResource Group.Panel}" Content="{Binding Clipboard}"
                                ContentTemplate="{StaticResource ClipboardViewModel.Panel}" />
            </DockPanel>
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Shelf}" Value="{x:Null}">
                <Setter TargetName="ShelfColumn" Property="Width" Value="0" />
                <Setter TargetName="ShelfSection" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Clipboard}" Value="{x:Null}">
                <Setter TargetName="ClipboardColumn" Property="Width" Value="0" />
                <Setter TargetName="ClipboardSection" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A card that holds one piece of the System page and disappears with its module. -->
    <Style x:Key="Group.Card" TargetType="ContentControl" BasedOn="{StaticResource Group.Panel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Style="{StaticResource Island.Card}" Padding="14,12">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A quick-action tile: icon and label on an inset surface. -->
    <Style x:Key="System.ActionTile" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="64" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Padding="6,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Raised}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.7" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="System.VolumeCard">
        <StackPanel VerticalAlignment="Center">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Volume, StringFormat={}{0:0}%}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
                <TextBlock Text="Volume" FontSize="11" Foreground="{DynamicResource Island.Subtle}" />
            </DockPanel>
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource Island.IconButton}" Content="{Binding VolumeGlyph}"
                        Command="{Binding ToggleMuteCommand}" ToolTip="Mute" AutomationProperties.Name="Toggle mute" />
                <Slider Style="{StaticResource Island.Slider}" Minimum="0" Maximum="100" Value="{Binding Volume}"
                        Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Volume" />
            </DockPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Five quick actions in one row: icon over label, so the row fills the width and leaves no gaps. -->
    <DataTemplate x:Key="System.Actions">
        <UniformGrid Columns="5" Margin="0,0,-10,0">
            <Button Style="{StaticResource System.ActionTile}" Command="{Binding ScreenshotCommand}" Margin="0,0,10,0" AutomationProperties.Name="Screenshot">
                <StackPanel>
                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource Island.IconFont}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="Screenshot" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding ToggleMicCommand}" Margin="0,0,10,0" AutomationProperties.Name="Mute or unmute the microphone">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource System.ActionTile}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MicMuted}" Value="True">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{DynamicResource Island.SelectedBackground}" CornerRadius="{shell:Round 14}" Padding="6,0" TextElement.Foreground="{DynamicResource Island.SelectedForeground}">
                                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding MicGlyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding MicLabel}" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource System.ActionTile}" Command="{Binding LockCommand}" Margin="0,0,10,0" AutomationProperties.Name="Lock the PC">
                <StackPanel>
                    <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Island.IconFont}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="Lock" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource System.ActionTile}" Command="{Binding ScreenOffCommand}" Margin="0,0,10,0" AutomationProperties.Name="Turn the display off">
                <StackPanel>
                    <TextBlock Text="&#xE708;" FontFamily="{StaticResource Island.IconFont}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="Screen off" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource System.ActionTile}" Command="{Binding DownloadsCommand}" Margin="0,0,10,0" AutomationProperties.Name="Open Downloads">
                <StackPanel>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource Island.IconFont}" FontSize="18" HorizontalAlignment="Center" />
                    <TextBlock Text="Downloads" FontSize="12" FontWeight="Medium" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Button>
        </UniformGrid>
    </DataTemplate>

    <!-- Network, Bluetooth and battery, beside the volume. -->
    <DataTemplate x:Key="System.Status">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="FontSize" Value="13" />
                </Style>
            </Grid.Resources>
            <TextBlock Text="Network" Foreground="{DynamicResource Island.Subtle}" Margin="0,3,18,3" />
            <TextBlock Grid.Column="1" Text="{Binding Network}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="1" Text="Bluetooth" Foreground="{DynamicResource Island.Subtle}" Margin="0,3,18,3" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Bluetooth}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Row="2" Text="Battery" Foreground="{DynamicResource Island.Subtle}" Margin="0,3,18,3"
                       Visibility="{Binding HasBattery, Converter={StaticResource Island.BoolToVisibility}}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Battery}"
                       Visibility="{Binding HasBattery, Converter={StaticResource Island.BoolToVisibility}}" />
        </Grid>
    </DataTemplate>

    <!-- System: readings; volume beside the connection status; the five actions in one row; Bluetooth batteries.
         Every row spans the full width, so nothing is left empty. -->
    <DataTemplate x:Key="SystemGroupViewModel.Panel">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <ContentControl Style="{StaticResource Group.Panel}" Content="{Binding Stats}"
                                ContentTemplate="{StaticResource StatsViewModel.Tiles}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding Sound}" ContentTemplate="{StaticResource System.VolumeCard}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource Group.Card}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Devices}" Value="{x:Null}">
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                    <ContentControl Content="{Binding Devices}" ContentTemplate="{StaticResource System.Status}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl" BasedOn="{StaticResource Group.Card}">
                                <Setter Property="Grid.Column" Value="2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Sound}" Value="{x:Null}">
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="3" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
                <ContentControl Style="{StaticResource Group.Panel}" Content="{Binding Actions}" ContentTemplate="{StaticResource System.Actions}" Margin="0,10,0,0" />
                <ContentControl Style="{StaticResource Group.Panel}" Content="{Binding Stats}" Margin="0,10,0,0"
                                ContentTemplate="{StaticResource StatsViewModel.Chips}" />
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
