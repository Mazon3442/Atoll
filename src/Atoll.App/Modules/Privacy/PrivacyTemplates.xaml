<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Status colors match the phone convention, so they stay the same in every theme: orange = microphone, green = camera. -->
    <SolidColorBrush x:Key="Privacy.Microphone" Color="#FF9F0A" />
    <SolidColorBrush x:Key="Privacy.Camera" Color="#30D158" />

    <DataTemplate x:Key="Privacy.Dots">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8" Fill="{StaticResource Privacy.Camera}" Margin="1,0"
                     Visibility="{Binding Camera, Converter={StaticResource Island.BoolToVisibility}}" />
            <Ellipse Width="8" Height="8" Fill="{StaticResource Privacy.Microphone}" Margin="1,0"
                     Visibility="{Binding Microphone, Converter={StaticResource Island.BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PrivacyViewModel.Compact">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Privacy.Dots}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Apps}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" MaxWidth="220"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PrivacyViewModel.Peek">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Description}">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Privacy.Dots}" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Apps}" FontSize="12" Foreground="{DynamicResource Island.Subtle}"
                           MaxWidth="320" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="PrivacyViewModel.Mini">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Privacy.Dots}"
                          ToolTip="{Binding Description}" AutomationProperties.Name="{Binding Description}" />
    </DataTemplate>

</ResourceDictionary>
