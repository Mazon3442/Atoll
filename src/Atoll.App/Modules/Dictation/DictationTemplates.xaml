<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell">

    <!-- Recording red stays the same in every theme, like the other status colours. -->
    <SolidColorBrush x:Key="Dictation.Recording" Color="#FF453A" />

    <!-- The voice meter: five bars that follow the level, so it reads as a meter without animating on its own. -->
    <DataTemplate x:Key="Dictation.Meter">
        <Grid Width="54" Height="16">
            <Border CornerRadius="{shell:Round}" Height="4" Background="{DynamicResource Island.Hover}" />
            <Border CornerRadius="{shell:Round}" Height="4" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5"
                    Background="{StaticResource Dictation.Recording}">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding Level, FallbackValue=0}" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DictationViewModel.Compact">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Status}">
            <shell:Icon Kind="mic" Size="14" Foreground="{StaticResource Dictation.Recording}" VerticalAlignment="Center"
                        Visibility="{Binding IsRecording, Converter={StaticResource Island.BoolToVisibility}}" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Dictation.Meter}" Margin="10,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding IsRecording, Converter={StaticResource Island.BoolToVisibility}}" />
            <TextBlock Text="{Binding Elapsed}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding IsRecording, Converter={StaticResource Island.BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                       Visibility="{Binding IsTranscribing, Converter={StaticResource Island.BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DictationViewModel.Peek">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Status}">
            <shell:Icon Kind="mic" Size="20" Foreground="{StaticResource Dictation.Recording}" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" FontSize="14" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                            Visibility="{Binding IsRecording, Converter={StaticResource Island.BoolToVisibility}}">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Dictation.Meter}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Elapsed}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
            <Button Style="{StaticResource Island.PrimaryChip}" Content="Done" Margin="0,0,8,0" Command="{Binding StopCommand}"
                    Visibility="{Binding IsRecording, Converter={StaticResource Island.BoolToVisibility}}"
                    AutomationProperties.Name="Stop and transcribe" />
            <Button Style="{StaticResource Island.ChipButton}" Content="Cancel" Margin="0" Command="{Binding CancelCommand}"
                    AutomationProperties.Name="Cancel dictation" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DictationViewModel.Mini">
        <shell:Icon Kind="mic" Size="14" Foreground="{StaticResource Dictation.Recording}" ToolTip="{Binding Status}"
                    AutomationProperties.Name="{Binding Status}" />
    </DataTemplate>

</ResourceDictionary>
