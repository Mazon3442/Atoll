<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell">

    <DataTemplate x:Key="ShelfViewModel.Panel">
        <!-- The whole panel accepts dropped files. -->
        <Border Background="Transparent" shell:FileDrop.Command="{Binding AddFilesCommand}">
            <Grid>
                <!-- Empty: drop target hint -->
                <Grid Margin="2" Visibility="{Binding IsEmpty, Converter={StaticResource Island.BoolToVisibility}}">
                    <Rectangle RadiusX="14" RadiusY="14" StrokeThickness="1.5" StrokeDashArray="4 3"
                               Stroke="{DynamicResource Island.Subtle}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Island.IconFont}" FontSize="26"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                        <TextBlock Text="Drop files here to keep them handy" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="Drag them back out to any app" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Island.Subtle}" />
                    </StackPanel>
                </Grid>

                <DockPanel Visibility="{Binding IsEmpty, Converter={StaticResource Island.InverseBoolToVisibility}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Island.ChipButton}" Content="Clear" Margin="0"
                                Command="{Binding ClearCommand}" />
                        <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Drag a tile out to move/copy the file; double-click opens it. -->
                                    <Border x:Name="Tile" Width="92" Height="96" Margin="0,0,6,6" CornerRadius="10" Padding="6"
                                            Background="{DynamicResource Island.Hover}" Cursor="Hand"
                                            shell:FileDrag.Path="{Binding Path}" ToolTip="{Binding Path}">
                                        <Border.InputBindings>
                                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}" />
                                        </Border.InputBindings>
                                        <Grid>
                                            <StackPanel>
                                                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,4,0,4" />
                                                <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" MaxHeight="30" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Island.Subtle}" />
                                            </StackPanel>
                                            <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-4,-4,0" Visibility="Collapsed">
                                                <Button Style="{StaticResource Island.IconButton}" Width="20" Height="20" FontSize="9" Content="&#xE838;"
                                                        ToolTip="Show in folder" Command="{Binding RevealCommand}" AutomationProperties.Name="Show in folder" />
                                                <Button Style="{StaticResource Island.IconButton}" Width="20" Height="20" FontSize="9" Content="&#xE711;"
                                                        ToolTip="Remove from shelf" Command="{Binding RemoveCommand}" AutomationProperties.Name="Remove from shelf" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Exists}" Value="False">
                                            <Setter TargetName="Tile" Property="Opacity" Value="0.45" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
