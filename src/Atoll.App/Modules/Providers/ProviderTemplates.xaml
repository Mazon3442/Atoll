<ResourceDictionary
    xmlns:shell="clr-namespace:Atoll.Shell" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shown while requests are in flight through the local gateway. -->
    <DataTemplate x:Key="ProviderViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource Island.IconFont}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource Island.AccentText}" />
            <TextBlock Text="{Binding Activity}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ProviderViewModel.Mini">
        <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource Island.IconFont}" FontSize="12" Foreground="{DynamicResource Island.AccentText}" />
    </DataTemplate>

    <DataTemplate x:Key="ProviderViewModel.Panel">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <TextBlock Text="No API keys yet. Add one in Settings › Agents › Your own API keys." FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Island.Subtle}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Providers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Providers}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Padding="12,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Activity}" FontSize="12" Margin="0,2,0,0" />
                                    <TextBlock Text="{Binding Totals}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Metrics}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>
</ResourceDictionary>
