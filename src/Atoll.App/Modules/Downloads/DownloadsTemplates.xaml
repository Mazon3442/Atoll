<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell">

    <!-- In progress: an arrow, the file (or how many), and the live size. -->
    <DataTemplate x:Key="DownloadsViewModel.Mini">
        <shell:Icon Kind="download" Size="14" Foreground="{DynamicResource Island.AccentText}" />
    </DataTemplate>

    <DataTemplate x:Key="DownloadsViewModel.Compact">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Summary}" AutomationProperties.Name="{Binding Summary}">
            <shell:Icon Kind="download" Size="14" Foreground="{DynamicResource Island.AccentText}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" MaxWidth="220"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource Island.Subtle}"
                       Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DownloadsViewModel.Peek">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Summary}">
            <shell:Icon Kind="download" Size="22" Foreground="{DynamicResource Island.AccentText}" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="320">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Finished: name, size, and the two useful things to do with it. -->
    <DataTemplate x:Key="DownloadCompleteViewModel.Mini">
        <shell:Icon Kind="download" Size="14" Foreground="{DynamicResource Island.AccentText}" />
    </DataTemplate>

    <DataTemplate x:Key="DownloadCompleteViewModel.Compact">
        <StackPanel Orientation="Horizontal" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
            <shell:Icon Kind="download" Size="14" Foreground="{DynamicResource Island.AccentText}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                       MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="DownloadCompleteViewModel.Peek">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Name}">
            <shell:Icon Kind="download" Size="22" Foreground="{DynamicResource Island.AccentText}" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="280">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource Island.ChipButton}" Content="Open" Margin="0,0,6,0"
                        Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}" />
                <Button Style="{StaticResource Island.ChipButton}" Content="Show in folder" Margin="0"
                        Command="{Binding RevealCommand}"
                        AutomationProperties.Name="{Binding Name, StringFormat=Show {0} in its folder}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
