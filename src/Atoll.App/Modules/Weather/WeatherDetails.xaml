<UserControl x:Class="Atoll.Modules.Weather.WeatherDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:weather="clr-namespace:Atoll.Modules.Weather"
             Focusable="False" ScrollViewer.VerticalScrollBarVisibility="Auto"
             Foreground="{DynamicResource Island.Foreground}">
    <UserControl.Resources>
        <Style x:Key="MetricItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Fill" Background="Transparent" CornerRadius="12" Padding="12,7">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Island.SelectedBackground}" />
                        <Setter Property="Foreground" Value="{DynamicResource Island.SelectedForeground}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DayItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat={}{0} forecast}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Fill" Background="Transparent" CornerRadius="9" Padding="10,5">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Fill" Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource AncestorType=UserControl}}"
                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
        <StackPanel Margin="6,4,6,6">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource Island.InverseBoolToVisibility}}" Margin="0,12">
                <TextBlock Text="Your local forecast" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Button Content="Weather settings" Command="{Binding OpenSettingsCommand}" Style="{StaticResource Island.ChipButton}" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource Island.BoolToVisibility}}">
                <Grid Margin="4,0,4,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding PlaceLabel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Island.AccentText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Place}" />
                        <TextBlock Text="{Binding TemperatureReading}" AutomationProperties.Name="{Binding Temperature}" FontSize="60" FontWeight="Light" LineHeight="70" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ConditionSummary}" FontSize="13" Opacity="0.85" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RainSummary}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <weather:WeatherSymbol Grid.Column="1" Code="{Binding ConditionCode}" IsDay="{Binding IsDay}" Width="66" Height="66" Margin="0,5,0,0" VerticalAlignment="Top"
                                           Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding Description}" />
                </Grid>
                <Border Height="1" Background="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,10" />
                <Grid Margin="4,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding MetricTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Island.AccentText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ChartReadout}" FontSize="11" Opacity="0.85" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                <Border Grid.Column="1" CornerRadius="15" Background="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="3" VerticalAlignment="Center">
                    <ListBox ItemsSource="{Binding Metrics}" SelectedValuePath="Value" SelectedValue="{Binding SelectedMetric}" DisplayMemberPath="Label"
                             ItemContainerStyle="{StaticResource MetricItem}" Background="Transparent" BorderThickness="0" FontSize="12"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Hourly forecast metric">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                </Border>
                </Grid>
                <weather:ForecastChart Points="{Binding ChartPoints}" Metric="{Binding SelectedMetric}" SelectedIndex="{Binding SelectedChartIndex}"
                                       Height="104" Margin="3,0,3,4" Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       Accent="{DynamicResource Island.Accent}" AutomationProperties.Name="Hourly weather chart"
                                       AutomationProperties.HelpText="Use the left and right arrows to inspect hours, or point at a reading. Home and End select the first and last hour. Times are local to this place." />
                <Border Height="1" Background="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,6,0,6" />
                <ListBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" ItemContainerStyle="{StaticResource DayItem}"
                         Background="Transparent" BorderThickness="0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Choose a forecast day">
                    <ListBox.ItemTemplate><DataTemplate>
                        <!-- Day, icon, low, the day's span within the week, high. -->
                        <Grid ToolTip="{Binding Condition}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" /><ColumnDefinition Width="28" /><ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                            <weather:WeatherSymbol Grid.Column="1" Code="{Binding Forecast.Code}" Width="18" Height="18" HorizontalAlignment="Left"
                                                   Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" AutomationProperties.Name="{Binding Condition}" />
                            <TextBlock Grid.Column="2" Text="{Binding Low}" FontSize="12" Opacity="0.7" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <weather:RangeBar Grid.Column="3" Start="{Binding BarStart}" End="{Binding BarEnd}" Height="12" VerticalAlignment="Center"
                                              Ink="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" Accent="{DynamicResource Island.Accent}" />
                            <TextBlock Grid.Column="4" Text="{Binding High}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding Updated}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="8,8,4,0" ToolTip="Forecast times are local to this place." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
