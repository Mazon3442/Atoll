<UserControl x:Class="Atoll.Modules.Weather.WeatherDetails"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False" ScrollViewer.VerticalScrollBarVisibility="Auto"
             Foreground="{DynamicResource Island.Foreground}">
    <UserControl.Resources>
        <Style x:Key="WeatherButton" TargetType="Button">
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Fill" Background="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" CornerRadius="6" Padding="10,6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.75" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.5" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fill" Property="Opacity" Value="0.4" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DayItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name, StringFormat={}{0} forecast}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="DayBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="3,8" Margin="1">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DayBorder" Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="DayBorder" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Setter TargetName="DayBorder" Property="Background" Value="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="{Binding Path=(ScrollViewer.VerticalScrollBarVisibility), RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource WeatherButton}" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh weather" />
                <Button DockPanel.Dock="Right" Content="Location" Style="{StaticResource WeatherButton}" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" AutomationProperties.Name="Choose weather location" />
                <TextBlock Text="{Binding Place}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource Island.BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="36" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <TextBlock Text="{Binding Temperature}" FontSize="30" FontWeight="SemiBold" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Description}" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Details}" Opacity="0.8" FontSize="12" />
                    </StackPanel>
                </Grid>
                <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,10,0,4"><Run Text="Wind  " FontWeight="SemiBold" /><Run Text="{Binding Wind, Mode=OneWay}" /></TextBlock>
                <TextBlock Text="{Binding RainSummary}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12" />
                <TextBlock Text="7-day forecast" FontSize="13" FontWeight="SemiBold" />
                <ListBox ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay}" Background="Transparent" BorderThickness="0" Margin="0,6,0,10"
                         ItemContainerStyle="{StaticResource DayItem}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Choose a forecast day">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="18" HorizontalAlignment="Center" Margin="0,4" />
                            <TextBlock Text="{Binding High}" FontSize="12" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Low}" FontSize="11" HorizontalAlignment="Center" Opacity="0.8" />
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{Binding DaySummary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBlock Text="Hourly forecast · times local to this place" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Time" FontSize="11" Opacity="0.8" />
                    <TextBlock Grid.Column="1" Text="Temp." FontSize="11" Opacity="0.8" />
                    <TextBlock Grid.Column="2" Text="Precip." FontSize="11" Opacity="0.8" />
                    <TextBlock Grid.Column="3" Text="Wind" FontSize="11" Opacity="0.8" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Hours}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{Binding HoverBrush, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Time}" FontSize="12" /><TextBlock Text="{Binding Condition}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,3,8,0" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Temperature}" FontSize="12" />
                                <StackPanel Grid.Column="2"><TextBlock Text="{Binding Chance}" FontSize="12" /><TextBlock Text="{Binding Precipitation}" FontSize="11" Opacity="0.8" Margin="0,3,0,0" /></StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Wind}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Hourly data is unavailable for this day." FontSize="12" TextWrapping="Wrap" Visibility="{Binding HasHours, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                <TextBlock Text="{Binding Updated}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
