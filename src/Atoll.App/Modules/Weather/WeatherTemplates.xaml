<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="WeatherViewModel.Panel">
        <Grid>
            <!-- No city yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasCity, Converter={StaticResource Island.InverseBoolToVisibility}}">
                <TextBlock Text="&#x26C5;" FontFamily="Segoe UI Symbol" FontSize="28" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Island.Subtle}" />
                <TextBlock Text="Add your city in Settings › Modules" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- City set, no report (loading or error) -->
            <TextBlock Text="{Binding Status}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="380">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasCity}" Value="True" />
                                    <Condition Binding="{Binding HasReport}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Report -->
            <DockPanel Visibility="{Binding HasReport, Converter={StaticResource Island.BoolToVisibility}}" Margin="6,0">
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Days}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                                <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="16" HorizontalAlignment="Center" Margin="0,2" />
                                <TextBlock HorizontalAlignment="Center" FontSize="12">
                                    <Run Text="{Binding High, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding Low, Mode=OneWay}" Foreground="{DynamicResource Island.Subtle}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="40" VerticalAlignment="Center"
                               Foreground="{DynamicResource Island.Accent}" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Place}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Temperature}" FontSize="34" FontWeight="Light" />
                            <TextBlock Text="{Binding Description}" FontSize="14" Margin="12,0,0,6" VerticalAlignment="Bottom" />
                        </StackPanel>
                        <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Island.IconButton}" Content="&#xE72C;" FontSize="12" ToolTip="Refresh"
                                Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh weather" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Updated}" FontSize="10" Foreground="{DynamicResource Island.Subtle}" />
                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Island.Subtle}" MaxWidth="140" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Grid>
    </DataTemplate>

    <!-- Quick actions: a row of large round buttons with labels. -->
    <Style x:Key="Action.Button" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent" Width="84">
                        <Border x:Name="Circle" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Island.Hover}">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Island.IconFont}" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" Margin="0,6,0,0" TextBlock.FontSize="11" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource Island.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="QuickActionsViewModel.Panel">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource Action.Button}" Tag="&#xE722;" Content="Screenshot" Command="{Binding ScreenshotCommand}" />
            <Button Style="{StaticResource Action.Button}" Tag="{Binding MicGlyph}" Content="{Binding MicLabel}" Command="{Binding ToggleMicCommand}" />
            <Button Style="{StaticResource Action.Button}" Tag="&#xE72E;" Content="Lock" Command="{Binding LockCommand}" />
            <Button Style="{StaticResource Action.Button}" Tag="&#xE708;" Content="Screen off" Command="{Binding ScreenOffCommand}" />
            <Button Style="{StaticResource Action.Button}" Tag="&#xE896;" Content="Downloads" Command="{Binding DownloadsCommand}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
