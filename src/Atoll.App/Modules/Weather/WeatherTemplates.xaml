<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell"
                    xmlns:weather="clr-namespace:Atoll.Modules.Weather">
    <DataTemplate x:Key="WeatherViewModel.Panel"><weather:WeatherDetails /></DataTemplate>

    <Style x:Key="Action.Button" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <StackPanel Background="Transparent" Width="84">
                        <Border x:Name="Circle" Width="52" Height="52" CornerRadius="{shell:Round}" Background="{DynamicResource Island.Hover}">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Island.IconFont}" FontSize="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter HorizontalAlignment="Center" Margin="0,6,0,0" TextBlock.FontSize="11" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource Island.Accent}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.7" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="QuickActionsViewModel.Panel">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource Action.Button}" Tag="&#xE722;" Content="Screenshot" Command="{Binding ScreenshotCommand}" />
            <Button Style="{StaticResource Action.Button}" Tag="{Binding MicGlyph}" Content="{Binding MicLabel}" Command="{Binding ToggleMicCommand}" />
            <Button Style="{StaticResource Action.Button}" Tag="&#xE72E;" Content="Lock" Command="{Binding LockCommand}" />
            <Button Style="{StaticResource Action.Button}" Tag="&#xE708;" Content="Screen off" Command="{Binding ScreenOffCommand}" />
            <Button Style="{StaticResource Action.Button}" Tag="&#xE896;" Content="Downloads" Command="{Binding DownloadsCommand}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
