<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell">

    <SolidColorBrush x:Key="Claude.Orange" Color="#D97757" />

    <!-- Every session carries its agent name, including in compact and alert views. -->
    <DataTemplate x:Key="Agent.Label">
        <TextBlock Text="{Binding AgentName}" FontSize="11" FontWeight="SemiBold"
                   Foreground="{DynamicResource Island.AccentText}" VerticalAlignment="Center" />
    </DataTemplate>

    <!-- Work activity -->
    <DataTemplate x:Key="ClaudeViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding Current}" ContentTemplate="{StaticResource Agent.Label}" />
            <TextBlock Text="{Binding Current.Detail}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                       MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CountBadge}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Claude.Orange}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ClaudeViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding Current}" ContentTemplate="{StaticResource Agent.Label}" VerticalAlignment="Center">
                <ContentPresenter.LayoutTransform>
                    <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                </ContentPresenter.LayoutTransform>
            </ContentPresenter>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="320">
                <TextBlock FontSize="12" Foreground="{DynamicResource Island.Subtle}">
                    <Run Text="{Binding Current.Project, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Current.Elapsed, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding Current.Detail}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <StackPanel Visibility="{Binding Current.IsClaude, Converter={StaticResource Island.BoolToVisibility}}">
                <TextBlock FontSize="11" Foreground="{DynamicResource Island.Subtle}" Margin="0,2,0,0"
                           Visibility="{Binding Usage.HasBlock, Converter={StaticResource Island.BoolToVisibility}}">
                    <Run Text="5h block " /><Run Text="{Binding Usage.BlockText, Mode=OneWay}" />
                </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ClaudeViewModel.Mini">
        <ContentPresenter Content="{Binding Current}" ContentTemplate="{StaticResource Agent.Label}" />
    </DataTemplate>

    <!-- Done / needs-you alerts -->
    <DataTemplate x:Key="ClaudeAlertViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding Session}" ContentTemplate="{StaticResource Agent.Label}" />
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ClaudeAlertViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding Session}" ContentTemplate="{StaticResource Agent.Label}" VerticalAlignment="Center">
                <ContentPresenter.LayoutTransform>
                    <ScaleTransform ScaleX="1.4" ScaleY="1.4" />
                </ContentPresenter.LayoutTransform>
            </ContentPresenter>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="320">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Grid Margin="14,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource Island.ChipButton}" Content="Open" Margin="0"
                        Command="{Binding Session.FocusCommand}"
                        Visibility="{Binding CanOpen, Converter={StaticResource Island.BoolToVisibility}}"
                        AutomationProperties.Name="Open the agent session" />
                <!-- Permission prompt: answer here, or hand it back to the terminal. -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding CanAnswer, Converter={StaticResource Island.BoolToVisibility}}">
                    <Button Style="{StaticResource Island.ChipButton}" Content="Allow" Margin="0,0,6,0" FontWeight="SemiBold"
                            Foreground="{StaticResource Claude.Orange}" Command="{Binding AllowCommand}"
                            AutomationProperties.Name="{Binding Detail, StringFormat=Allow: {0}}" />
                    <Button Style="{StaticResource Island.ChipButton}" Content="Deny" Margin="0,0,6,0" Command="{Binding DenyCommand}"
                            AutomationProperties.Name="{Binding Detail, StringFormat=Deny: {0}}" />
                    <Button Style="{StaticResource Island.ChipButton}" Content="Terminal" Margin="0" Command="{Binding TerminalCommand}"
                            ToolTip="Answer in the terminal instead"
                            AutomationProperties.Name="Answer in the terminal instead" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ClaudeAlertViewModel.Mini">
        <ContentPresenter Content="{Binding Session}" ContentTemplate="{StaticResource Agent.Label}" />
    </DataTemplate>

    <!-- Ask finished while the island may have been collapsed. The full answer stays in the Ask section. -->
    <DataTemplate x:Key="AskAlertViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Ask" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Claude.Orange}"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                       MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AskAlertViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Ask" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Claude.Orange}"
                       VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" MaxWidth="360">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="AskAlertViewModel.Mini">
        <TextBlock Text="Ask" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Claude.Orange}" />
    </DataTemplate>

    <!-- Expanded tab: Sessions (activity, usage, plan limits) and Ask (one question, one answer) -->
    <DataTemplate x:Key="ClaudeViewModel.Panel">
        <DataTemplate.Resources>
            <!-- Round send button inside the composer: quiet until there is something to send. -->
            <Style x:Key="Ask.SendButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Dot" Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource Island.Raised}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Island.Hover}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Ask.HasDraft}" Value="True">
                                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Island.Accent}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </DataTemplate.Resources>
        <StackPanel MinHeight="230">
            <Border Background="{DynamicResource Island.Surface}" CornerRadius="15" Padding="3"
                    HorizontalAlignment="Left" Margin="0,0,0,8">
                <ListBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource Island.SegmentItem}"
                         Background="Transparent" BorderThickness="0" FontSize="12"
                         Foreground="{DynamicResource Island.Subtle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Agents section">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <!-- Sessions -->
            <Grid Visibility="{Binding IsSessions, Converter={StaticResource Island.BoolToVisibility}}">
                <DockPanel>
                    <!-- Usage -->
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0"
                          Visibility="{Binding Usage.HasData, Converter={StaticResource Island.BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Usage.BlockResets}" FontSize="11"
                                           Foreground="{DynamicResource Island.Subtle}"
                                           Visibility="{Binding Usage.HasBlock, Converter={StaticResource Island.BoolToVisibility}}" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource Island.Subtle}">
                                    <Run Text="Claude · 5h block  " /><Run Text="{Binding Usage.BlockText, Mode=OneWay}" Foreground="{DynamicResource Island.Foreground}" />
                                </TextBlock>
                            </DockPanel>
                            <Grid Height="3" Margin="0,4,12,0">
                                <Border CornerRadius="1.5" Background="{DynamicResource Island.Hover}" />
                                <Border CornerRadius="1.5" Background="{StaticResource Claude.Orange}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding Usage.BlockProgress}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Top">
                            <Run Text="Claude today  " /><Run Text="{Binding Usage.TodayText, Mode=OneWay}" Foreground="{DynamicResource Island.Foreground}" />
                        </TextBlock>
                    </Grid>

                    <!-- Plan limits, as Claude and Codex report them -->
                    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Usage.Limits}" Margin="0,8,0,0"
                                  Visibility="{Binding Usage.HasLimits, Converter={StaticResource Island.BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,6" AutomationProperties.Name="{Binding Name}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ResetText}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Island.Subtle}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding PercentText, Mode=OneWay}" Foreground="{DynamicResource Island.Foreground}" />
                                        </TextBlock>
                                    </DockPanel>
                                    <Grid Height="3" Margin="0,4,0,0">
                                        <Border CornerRadius="1.5" Background="{DynamicResource Island.Hover}" />
                                        <Border x:Name="Fill" CornerRadius="1.5" Background="{DynamicResource Island.Accent}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Progress}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHigh}" Value="True">
                                        <Setter TargetName="Fill" Property="Background" Value="{StaticResource Claude.Orange}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sessions -->
                    <Grid>
                        <TextBlock Text="No agent sessions yet. Install integrations in Settings › Agents." HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"
                                   Foreground="{DynamicResource Island.Subtle}"
                                   Visibility="{Binding HasSessions, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Tracker.Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" CornerRadius="10" Padding="10,6" Margin="0,0,0,4" Background="{DynamicResource Island.Hover}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Island.ChipButton}" Content="Open"
                                                        Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding FocusCommand}"
                                                        Visibility="{Binding CanFocus, Converter={StaticResource Island.BoolToVisibility}}"
                                                        AutomationProperties.Name="{Binding Project, StringFormat=Open {0}}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Island.Subtle}" />
                                                <ContentPresenter DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource Agent.Label}"
                                                                  Margin="0,0,10,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Project}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding NeedsYou}" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Claude.Orange}" />
                                                <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Ask: the first installed CLI agent, then your own API keys. -->
            <Grid Visibility="{Binding IsAsk, Converter={StaticResource Island.BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Empty state: who answers, what stays local, and three things to try. -->
                <Grid Height="188" Visibility="{Binding Ask.IsEmpty, Converter={StaticResource Island.BoolToVisibility}}">
                    <StackPanel MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="26" Height="26" HorizontalAlignment="Center" Stretch="Uniform"
                              Fill="{DynamicResource Island.Accent}" Opacity="0.9"
                              Data="M12 2 C12.7 7.2 14.8 9.3 20 10 C14.8 10.7 12.7 12.8 12 18 C11.3 12.8 9.2 10.7 4 10 C9.2 9.3 11.3 7.2 12 2 Z M19 1.5 C19.25 3.4 20.1 4.25 22 4.5 C20.1 4.75 19.25 5.6 19 7.5 C18.75 5.6 17.9 4.75 16 4.5 C17.9 4.25 18.75 3.4 19 1.5 Z" />
                        <TextBlock Text="{Binding Ask.Title}" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,10,0,4" AutomationProperties.Name="Ask AI" />
                        <TextBlock Text="{Binding Ask.Subtitle}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{DynamicResource Island.Subtle}" LineHeight="16" />
                        <ItemsControl ItemsSource="{Binding Ask.Suggestions}" Margin="0,13,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Island.ChipButton}" Content="{Binding}"
                                            FontSize="11" Margin="3"
                                            Command="{Binding DataContext.Ask.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- The answer, or the error, fills the same space once a question has been asked. -->
                <Grid Height="188" Visibility="{Binding Ask.HasAnswer, Converter={StaticResource Island.BoolToVisibility}}">
                    <ScrollViewer x:Name="AskAnswerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" AutomationProperties.Name="The answer">
                        <TextBlock Text="{Binding Ask.Answer}" FontSize="12.5" TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding Ask.Error}" FontSize="11" TextWrapping="Wrap" Margin="2,8,2,0"
                               Foreground="{StaticResource Claude.Orange}" AutomationProperties.LiveSetting="Assertive"
                               Visibility="{Binding Ask.HasError, Converter={StaticResource Island.BoolToVisibility}}" />
                    <DockPanel Margin="2,6,2,0" Visibility="{Binding Ask.HasStatusLine, Converter={StaticResource Island.BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Ask.SourceLine}" FontSize="10"
                                   Foreground="{DynamicResource Island.Subtle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Ask.Status}" FontSize="10" Foreground="{DynamicResource Island.Subtle}" />
                    </DockPanel>
                </StackPanel>

                <!-- Composer: one line that grows, with the send button inside it. -->
                <Border Grid.Row="2" Background="{DynamicResource Island.Surface}" CornerRadius="14"
                        Padding="12,4,4,4" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <TextBox x:Name="AskInput" Style="{StaticResource Island.Input}"
                                     Text="{Binding Ask.Draft, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Padding="0,5" FontSize="12.5"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30" MaxHeight="84"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Ask a question">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding Ask.SendCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <TextBlock Text="Ask anything…" FontSize="12.5" Margin="1,6,0,0" IsHitTestVisible="False"
                                       Foreground="{DynamicResource Island.Subtle}"
                                       Visibility="{Binding Ask.HasDraft, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                        </Grid>

                        <Button Grid.Column="1" Style="{StaticResource Ask.SendButton}" Margin="8,0,0,0"
                                Command="{Binding Ask.SendCommand}" ToolTip="Send (Ctrl+Enter)"
                                Visibility="{Binding Ask.IsRunning, Converter={StaticResource Island.InverseBoolToVisibility}}"
                                AutomationProperties.Name="Send the question">
                            <shell:Icon Kind="arrow-up" Size="14" />
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource Ask.SendButton}" Margin="8,0,0,0"
                                Command="{Binding Ask.StopCommand}" ToolTip="Stop the answer"
                                Visibility="{Binding Ask.IsRunning, Converter={StaticResource Island.BoolToVisibility}}"
                                AutomationProperties.Name="Stop the answer">
                            <Path Width="9" Height="9" Fill="{DynamicResource Island.Foreground}"
                                  Data="M0,0 H9 V9 H0 Z" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
