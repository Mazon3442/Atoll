<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="SystemPanelViewModel.Panel">
        <StackPanel VerticalAlignment="Center" Margin="8,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource Island.IconButton}" Content="{Binding VolumeGlyph}"
                        Command="{Binding ToggleMuteCommand}" ToolTip="Mute" AutomationProperties.Name="Toggle mute" />
                <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding Volume, StringFormat={}{0:0}%}" />
                <Slider Style="{StaticResource Island.Slider}" Minimum="0" Maximum="100" Value="{Binding Volume}"
                        Margin="10,0" VerticalAlignment="Center" AutomationProperties.Name="Volume" />
            </DockPanel>

            <Grid Margin="4,18,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="FontSize" Value="13" />
                    </Style>
                </Grid.Resources>

                <TextBlock Text="Network" Foreground="{DynamicResource Island.Subtle}" Margin="0,3,24,3" />
                <TextBlock Grid.Column="1" Text="{Binding Network}" />

                <TextBlock Grid.Row="1" Text="Bluetooth" Foreground="{DynamicResource Island.Subtle}" Margin="0,3,24,3" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Bluetooth}" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="2" Text="Battery" Foreground="{DynamicResource Island.Subtle}" Margin="0,3,24,3"
                           Visibility="{Binding HasBattery, Converter={StaticResource Island.BoolToVisibility}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Battery}"
                           Visibility="{Binding HasBattery, Converter={StaticResource Island.BoolToVisibility}}" />
            </Grid>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
