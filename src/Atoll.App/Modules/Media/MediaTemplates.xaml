<ResourceDictionary x:Class="Atoll.Modules.Media.MediaTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell"
                    xmlns:media="clr-namespace:Atoll.Modules.Media">

    <!-- Album art with a music-note fallback underneath (shows when the player gives no artwork). -->
    <DataTemplate x:Key="Media.Art">
        <Grid>
            <Border Background="{DynamicResource Island.Hover}" CornerRadius="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Island.IconFont}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
            </Border>
            <Border CornerRadius="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Art}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Five bars driven by VisualizerViewModel; scaled around the middle like the iPhone island. -->
    <DataTemplate x:Key="Media.Bars">
        <StackPanel Orientation="Horizontal" Height="16" DataContext="{Binding Visualizer}">
            <StackPanel.Resources>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="3" />
                    <Setter Property="Height" Value="16" />
                    <Setter Property="Margin" Value="1,0" />
                    <Setter Property="CornerRadius" Value="1.5" />
                    <Setter Property="Background" Value="{Binding Color}" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                </Style>
            </StackPanel.Resources>
            <Border><Border.RenderTransform><ScaleTransform ScaleY="{Binding Bar0}" /></Border.RenderTransform></Border>
            <Border><Border.RenderTransform><ScaleTransform ScaleY="{Binding Bar1}" /></Border.RenderTransform></Border>
            <Border><Border.RenderTransform><ScaleTransform ScaleY="{Binding Bar2}" /></Border.RenderTransform></Border>
            <Border><Border.RenderTransform><ScaleTransform ScaleY="{Binding Bar3}" /></Border.RenderTransform></Border>
            <Border><Border.RenderTransform><ScaleTransform ScaleY="{Binding Bar4}" /></Border.RenderTransform></Border>
        </StackPanel>
    </DataTemplate>

    <!-- Shows the source on screen (it follows the active player); pick another from the list. -->
    <DataTemplate x:Key="Media.SourcePicker">
        <ComboBox Style="{StaticResource Island.Picker}" ItemsSource="{Binding Sources}"
                  SelectedItem="{Binding SelectedSource, Mode=TwoWay}" Tag="Choose source" MaxWidth="200"
                  AutomationProperties.Name="Audio source" ToolTip="Switch player or audio app">
            <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </DataTemplate>

    <DataTemplate x:Key="MediaViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Media.Art}" Tag="5"
                              Width="20" Height="20" VerticalAlignment="Center" />
            <Border Width="72" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Media.Bars}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MediaViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Media.Art}" Tag="8"
                              Width="40" Height="40" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,16,0" VerticalAlignment="Center" MaxWidth="260">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource Island.Subtle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Media.Bars}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MediaViewModel.Mini">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Media.Art}" Tag="10" Width="20" Height="20" />
    </DataTemplate>

    <DataTemplate x:Key="MediaViewModel.Panel">
        <Grid>
            <!-- Nothing playing; audio-only apps can still be picked. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSession, Converter={StaticResource Island.InverseBoolToVisibility}}">
                <TextBlock Text="Nothing playing" HorizontalAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Media.SourcePicker}"
                                  HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Visibility="{Binding HasSession, Converter={StaticResource Island.BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Lyrics (or the cat) sit on their own card beside the player. -->
                <Border Grid.Column="2" VerticalAlignment="Stretch">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Island.Card}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLyrics}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowBongoCat}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                <!-- Synced lyrics: the song scrolls past, the sung line bright and the rest dimmed, faded at the edges. -->
                <Border Width="230" Height="150" ClipToBounds="True" Background="Transparent"
                        VerticalAlignment="Center" Loaded="LyricsLoaded" Unloaded="LyricsUnloaded"
                        AutomationProperties.Name="{Binding Lyric, StringFormat=Lyrics: {0}}"
                        Visibility="{Binding HasLyrics, Converter={StaticResource Island.BoolToVisibility}}">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Transparent" Offset="0" />
                            <GradientStop Color="Black" Offset="0.12" />
                            <GradientStop Color="Black" Offset="0.88" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <Canvas>
                        <ItemsControl ItemsSource="{Binding LyricLines}" Width="230" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- The sung line reads like Apple Music: bold and bright, the rest still legible. -->
                                    <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" Margin="0,4"
                                               Foreground="{DynamicResource Island.Foreground}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="Opacity" Value="0.52" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Border>

                <!-- Opt-in joke: a cat drums in the lyrics slot while lyrics are off. It moves only while music plays. -->
                <media:BongoCatView Width="230" Height="150" VerticalAlignment="Center"
                                    Variant="{Binding BongoCat}" Playing="{Binding IsPlaying}"
                                    Visibility="{Binding ShowBongoCat, Converter={StaticResource Island.BoolToVisibility}}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Island.Card}" Padding="16" VerticalAlignment="Stretch">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="230" />
                </Grid.ColumnDefinitions>


                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Media.Art}" Tag="14" VerticalAlignment="Center">
                    <ContentPresenter.Style>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Width" Value="120" />
                            <Setter Property="Height" Value="120" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasLyrics}" Value="True">
                                    <Setter Property="Width" Value="96" />
                                    <Setter Property="Height" Value="96" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShowBongoCat}" Value="True">
                                    <Setter Property="Width" Value="96" />
                                    <Setter Property="Height" Value="96" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentPresenter.Style>
                </ContentPresenter>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding ToggleLyricsCommand}"
                                      Width="26" Height="26" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Show or hide synced lyrics"
                                      Foreground="{DynamicResource Island.Foreground}" Background="Transparent"
                                      AutomationProperties.Name="Lyrics" FocusVisualStyle="{StaticResource Island.FocusVisual}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Chip" CornerRadius="13" Background="{DynamicResource Island.Surface}">
                                        <shell:Icon x:Name="Glyph" Kind="mic-vocal" Size="14" Opacity="0.55"
                                                    Foreground="{DynamicResource Island.Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ShowLyrics}" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Island.Raised}" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Island.Hover}" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Artist}" FontSize="13" Foreground="{DynamicResource Island.Subtle}"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Margin="-6,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Media.SourcePicker}" />
                        <ComboBox Grid.Column="1" Style="{StaticResource Island.Picker}" ItemsSource="{Binding Outputs}" Margin="4,0,0,0"
                                  HorizontalAlignment="Left" SelectedItem="{Binding SelectedOutput, Mode=TwoWay}" Tag="Output" MaxWidth="200"
                                  AutomationProperties.Name="Audio output" ToolTip="Play through another speaker or headphones"
                                  Visibility="{Binding HasOutputs, Converter={StaticResource Island.BoolToVisibility}}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasTimeline, Converter={StaticResource Island.BoolToVisibility}}">
                        <Slider Minimum="0" Maximum="1"
                                IsMoveToPointEnabled="True" Loaded="SeekLoaded"
                                Value="{Binding Progress, Mode=OneWay}" IsEnabled="{Binding CanSeek}"
                                SmallChange="0.01" LargeChange="0.1"
                                Thumb.DragStarted="SeekStarted" Thumb.DragCompleted="SeekCompleted"
                                PreviewKeyDown="SeekKeyPressed"
                                PreviewKeyUp="SeekKeyReleased" LostKeyboardFocus="SeekFocusLost"
                                AutomationProperties.Name="Song position" ToolTipService.ShowOnDisabled="True">
                            <Slider.Style>
                                <Style TargetType="Slider" BasedOn="{StaticResource Island.Slider}">
                                    <Setter Property="ToolTip" Value="Seek in the current track" />
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                            <Setter Property="ToolTip" Value="Seeking is unavailable in this player" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Slider.Style>
                        </Slider>
                        <DockPanel Margin="0,3,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding DurationText}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" />
                            <TextBlock Text="{Binding PositionText}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" />
                        </DockPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Width="30" Height="30" Margin="0,0,6,0" Command="{Binding ToggleShuffleCommand}" ToolTip="Shuffle"
                                AutomationProperties.Name="Shuffle">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Island.IconButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShuffling}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Island.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <shell:Icon Kind="shuffle" Size="15" />
                        </Button>
                        <Button Style="{StaticResource Island.IconButton}" Content="&#xE892;" Width="36" Height="36" FontSize="16"
                                Command="{Binding PreviousCommand}" ToolTip="Previous" AutomationProperties.Name="Previous track" />
                        <Button Width="34" Height="34" FontSize="20" Margin="10,0"
                                Command="{Binding PlayPauseCommand}" ToolTip="Play or pause" AutomationProperties.Name="Play or pause">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Island.IconButton}">
                                    <Setter Property="Content" Value="&#xE768;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Content" Value="&#xE769;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource Island.IconButton}" Content="&#xE893;" Width="36" Height="36" FontSize="16"
                                Command="{Binding NextCommand}" ToolTip="Next" AutomationProperties.Name="Next track" />
                        <Button Width="30" Height="30" Margin="6,0,0,0" Command="{Binding CycleRepeatCommand}" ToolTip="Repeat"
                                AutomationProperties.Name="Repeat">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Island.IconButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRepeating}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Island.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <shell:Icon Size="15">
                                <shell:Icon.Style>
                                    <Style TargetType="shell:Icon">
                                        <Setter Property="Kind" Value="repeat" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepeatingOne}" Value="True">
                                                <Setter Property="Kind" Value="repeat-1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </shell:Icon.Style>
                            </shell:Icon>
                        </Button>
                    </StackPanel>
                </StackPanel>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
