<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell"
                    xmlns:cal="clr-namespace:Atoll.Modules.Calendar">

    <Style x:Key="Calendar.Action" TargetType="Button" BasedOn="{StaticResource Island.IconButton}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
        </Style.Triggers>
    </Style>
    <!-- A filled pin: Segoe Fluent's fill layer (E842) under the pin outline (E718). -->
    <DataTemplate x:Key="Calendar.PinnedGlyph">
        <Grid>
            <TextBlock Text="&#xE842;" />
            <TextBlock Text="&#xE718;" />
        </Grid>
    </DataTemplate>
    <Style x:Key="Calendar.PinAction" TargetType="Button" BasedOn="{StaticResource Calendar.Action}">
        <Setter Property="Content" Value="&#xE718;" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter Property="ContentTemplate" Value="{StaticResource Calendar.PinnedGlyph}" />
                <Setter Property="Foreground" Value="{DynamicResource Island.AccentText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A day in the month grid: hover disc, today's accent fill, selected ring, event dots. -->
    <Style x:Key="Calendar.DayItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleLabel}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Height="34" Background="Transparent">
                        <Border x:Name="Hover" CornerRadius="{shell:Round}" Background="Transparent" Margin="1" />
                        <Ellipse x:Name="Today" Width="26" Height="26" Fill="{DynamicResource Island.Accent}" Visibility="Collapsed" />
                        <Border x:Name="Selected" Width="30" Height="30" CornerRadius="{shell:Round}" BorderThickness="1.5"
                                BorderBrush="{DynamicResource Island.Foreground}" Visibility="Collapsed" />
                        <TextBlock x:Name="Day" Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ItemsControl x:Name="Dots" ItemsSource="{Binding DotColors}" VerticalAlignment="Bottom"
                                      HorizontalAlignment="Center" Margin="0,0,0,3" Focusable="False" IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Ellipse Width="4" Height="4" Margin="1,0" Fill="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Island.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding InMonth}" Value="False">
                            <Setter TargetName="Day" Property="Opacity" Value="0.32" />
                            <Setter TargetName="Dots" Property="Opacity" Value="0.4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                            <Setter TargetName="Today" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Day" Property="Foreground" Value="White" />
                            <Setter TargetName="Dots" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Next event: pill. Pin and dismiss live in the peek, where there is room to hit them. -->
    <DataTemplate x:Key="NextEventViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
            <TextBlock Text="{Binding When}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Island.AccentText}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NextEventViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <Border Width="4" Height="34" CornerRadius="{shell:Round}" Background="{Binding Color}" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Island.Subtle}"
                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
            </StackPanel>
            <TextBlock Text="{Binding When}" FontSize="13" FontWeight="SemiBold" Margin="16,0,6,0"
                       Foreground="{DynamicResource Island.AccentText}" VerticalAlignment="Center" />
            <Button Style="{StaticResource Calendar.PinAction}" Command="{Binding TogglePinCommand}" VerticalAlignment="Center"
                    ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}" />
            <Button Style="{StaticResource Calendar.Action}" Content="&#xE711;" VerticalAlignment="Center"
                    Command="{Binding DismissCommand}" ToolTip="Dismiss from island" AutomationProperties.Name="Dismiss event from island" />
        </StackPanel>
    </DataTemplate>

    <!-- Pre-event popup. -->
    <DataTemplate x:Key="CalendarAlertViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CalendarAlertViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <Border Width="4" Height="34" CornerRadius="{shell:Round}" Background="{Binding Color}" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.AccentText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- One event. The first day's events are two lines (title over "time · place"); later days are one
         line with the start time. Pin and dismiss appear on hover or keyboard focus; a pinned event
         keeps a filled pin, and only now/next carry an accent badge. -->
    <DataTemplate x:Key="CalendarEventViewModel.Row">
        <Border x:Name="Row" Background="Transparent" CornerRadius="{shell:Round 14}" Padding="6,3,4,3" Margin="-6,0,0,0"
                BorderThickness="1" BorderBrush="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                AutomationProperties.Name="{Binding Event.DisplayTitle}" AutomationProperties.HelpText="{Binding Event.Detail}"
                ToolTip="{Binding Event.DisplayTitle}" ToolTipService.InitialShowDelay="900">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Bar" Width="3" CornerRadius="{shell:Round}" Background="{Binding Event.Color}" Margin="0,1,9,1" />
                <StackPanel x:Name="Text" Grid.Column="1" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock x:Name="Badge" DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                        <ContentPresenter x:Name="PinMark" DockPanel.Dock="Right" ContentTemplate="{StaticResource Calendar.PinnedGlyph}"
                                          TextElement.FontFamily="{StaticResource Island.IconFont}" TextElement.FontSize="11"
                                          TextElement.Foreground="{DynamicResource Island.AccentText}"
                                          Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="Title" Text="{Binding Event.DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock x:Name="Detail" Text="{Binding Event.Detail}" FontSize="11" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Island.Subtle}" />
                </StackPanel>
                <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="4,0,0,0" Visibility="Collapsed">
                    <Button Style="{StaticResource Calendar.PinAction}" Command="{Binding TogglePinCommand}"
                            ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}" />
                    <Button Style="{StaticResource Calendar.Action}" Content="&#xE711;" Command="{Binding DismissCommand}"
                            ToolTip="Dismiss from island" AutomationProperties.Name="Dismiss event from island" />
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Title" Property="FontSize" Value="12" />
                <Setter TargetName="Title" Property="FontWeight" Value="Normal" />
                <Setter TargetName="Row" Property="Padding" Value="6,2,4,2" />
                <Setter TargetName="Bar" Property="Margin" Value="0,2,9,2" />
                <!-- The buttons overhang a one-line row so it doesn't grow on hover. -->
                <Setter TargetName="Actions" Property="Margin" Value="4,-4,0,-4" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Badge" Property="Foreground" Value="{DynamicResource Island.AccentText}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter TargetName="PinMark" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDismissed}" Value="True">
                <Setter TargetName="Text" Property="Opacity" Value="0.5" />
                <Setter TargetName="Bar" Property="Opacity" Value="0.4" />
            </DataTrigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Island.Raised}" />
                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PinMark" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Island.Raised}" />
                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PinMark" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="Row" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Island.Foreground}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Selected day's agenda: time and duration, color bar, title, place, Join, and hover actions. -->
    <DataTemplate x:Key="CalendarEventViewModel.Agenda">
        <Border x:Name="Row" Background="{DynamicResource Island.Hover}" CornerRadius="{shell:Round 14}" Padding="12,8" Margin="0,0,0,6"
                BorderThickness="1" BorderBrush="Transparent" Focusable="True" FocusVisualStyle="{x:Null}"
                AutomationProperties.Name="{Binding Event.DisplayTitle}" AutomationProperties.HelpText="{Binding Event.Detail}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Top" Margin="0,1,10,0">
                    <TextBlock x:Name="Time" Text="{Binding Event.StartText}" FontSize="12" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="Duration" Text="{Binding Event.DurationText}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource Island.Subtle}" />
                </StackPanel>
                <Border Grid.Column="1" Width="3" CornerRadius="{shell:Round}" Background="{Binding Event.Color}" Margin="0,1,10,1" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock x:Name="Badge" DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Island.AccentText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Event.DisplayTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <TextBlock Text="{Binding Event.Subtitle}" FontSize="11" Foreground="{DynamicResource Island.Subtle}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Style="{StaticResource Island.PrimaryChip}" Padding="10,0" MinHeight="26" Margin="0,0,4,0" FontSize="11"
                            Command="{Binding JoinCommand}" Visibility="{Binding CanJoin, Converter={StaticResource Island.BoolToVisibility}}"
                            AutomationProperties.Name="{Binding Event.DisplayTitle, StringFormat=Join {0}}">
                        <StackPanel Orientation="Horizontal">
                            <shell:Icon Kind="video" Size="12" VerticalAlignment="Center" />
                            <TextBlock Text="Join" Margin="5,0,0,0" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="Actions" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource Calendar.PinAction}" Command="{Binding TogglePinCommand}"
                                ToolTip="{Binding PinLabel}" AutomationProperties.Name="{Binding PinLabel}" />
                        <Button Style="{StaticResource Calendar.Action}" Content="&#xE711;" Command="{Binding DismissCommand}"
                                ToolTip="Dismiss from island" AutomationProperties.Name="Dismiss event from island" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Event.AllDay}" Value="True">
                <Setter TargetName="Duration" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDismissed}" Value="True">
                <Setter TargetName="Row" Property="Opacity" Value="0.55" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource Island.AccentText}" />
            </DataTrigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Island.Surface}" />
                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Island.Surface}" />
                <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger SourceName="Row" Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Island.Foreground}" />
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Expanded panel: a month on the left and the selected day's agenda on the right. -->
    <DataTemplate x:Key="CalendarViewModel.Panel">
        <Grid MinHeight="252">
            <!-- No calendars yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSources, Converter={StaticResource Island.InverseBoolToVisibility}}">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource Island.IconFont}" FontSize="24"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                <TextBlock Text="{Binding EmptyMessage}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                <Button Style="{StaticResource Island.ChipButton}" Content="Add a calendar" Command="{Binding OpenSettingsCommand}"
                        HorizontalAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>

            <Grid Visibility="{Binding HasSources, Converter={StaticResource Island.BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <!-- Month -->
                <Border Style="{StaticResource Island.Card}" Padding="14,12" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel Margin="2,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Calendar.Action}" Content="&#xE72C;"
                                Foreground="{DynamicResource Island.Subtle}" Command="{Binding RefreshCommand}"
                                ToolTip="{Binding RefreshLabel}" AutomationProperties.Name="{Binding RefreshLabel}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Calendar.Action}" Content="&#xE76C;"
                                Command="{Binding NextMonthCommand}" ToolTip="Next month" AutomationProperties.Name="Next month" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Calendar.Action}" Content="&#xE76B;"
                                Command="{Binding PreviousMonthCommand}" ToolTip="Previous month" AutomationProperties.Name="Previous month" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Island.ChipButton}" Content="Today" Margin="0,0,6,0"
                                Padding="10,3" FontSize="11" Command="{Binding TodayCommand}" AutomationProperties.Name="Go to today" />
                        <TextBlock Text="{Binding MonthTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{x:Static cal:CalendarViewModel.WeekdayInitials}" Focusable="False" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Island.Subtle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListBox x:Name="CalendarMonth" ItemsSource="{Binding MonthCells}"
                             SelectedItem="{Binding SelectedCell, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Calendar.DayItem}"
                             Background="Transparent" BorderThickness="0" Focusable="True"
                             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                             KeyboardNavigation.DirectionalNavigation="Contained"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Month">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <TextBlock Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" Margin="2,6,4,0"
                               Foreground="{DynamicResource Island.Subtle}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                </Border>

                <!-- Selected day -->
                <Border Grid.Column="2" Style="{StaticResource Island.Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectedDayCount}" FontSize="11"
                                   Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedDayTitle}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" />
                            <TextBlock Text="{Binding SelectedDayDate}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding SelectedDayRows}" ItemTemplate="{StaticResource CalendarEventViewModel.Agenda}"
                                      Focusable="False" Margin="0,0,6,0" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowSelectedDayEmpty, Converter={StaticResource Island.BoolToVisibility}}">
                        <TextBlock Text="{Binding SelectedDayEmptyMessage}" FontSize="12"
                                   Foreground="{DynamicResource Island.Subtle}" />
                        <Button Style="{StaticResource Island.ChipButton}" Content="Manage calendars" Margin="0,8,0,0"
                                HorizontalAlignment="Center" Command="{Binding OpenSettingsCommand}" />
                    </StackPanel>
                </Grid>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
