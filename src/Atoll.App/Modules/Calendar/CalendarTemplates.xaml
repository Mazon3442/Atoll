<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Next event: pill. -->
    <DataTemplate x:Key="NextEventViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
            <TextBlock Text="{Binding When}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Island.Subtle}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="NextEventViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="12" Height="12" Fill="{Binding Color}" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Island.Subtle}"
                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
            </StackPanel>
            <TextBlock Text="{Binding When}" FontSize="13" FontWeight="SemiBold" Margin="16,0,0,0"
                       Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Pre-event popup. -->
    <DataTemplate x:Key="CalendarAlertViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{Binding Color}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CalendarAlertViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="12" Height="12" Fill="{Binding Color}" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- Expanded panel: events grouped by day. -->
    <DataTemplate x:Key="CalendarViewModel.Panel">
        <Grid>
            <!-- Empty state -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource Island.BoolToVisibility}}">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource Island.IconFont}" FontSize="28"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Island.Subtle}" />
                <TextBlock Text="{Binding EmptyMessage}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
            </StackPanel>

            <!-- Event list -->
            <DockPanel Visibility="{Binding HasEvents, Converter={StaticResource Island.BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,4">
                    <Button Style="{StaticResource Island.IconButton}" Content="&#xE72C;" FontSize="12" ToolTip="Refresh"
                            Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh calendars" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,4,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,4"
                                               Foreground="{DynamicResource Island.Subtle}" />
                                    <ItemsControl ItemsSource="{Binding Events}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Color}"
                                                             VerticalAlignment="Center" Margin="2,0,10,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding StartText}" FontSize="12"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                                   Foreground="{DynamicResource Island.Subtle}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding EndText}" FontSize="11"
                                                               Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,4,0">
                    <TextBlock Text="{Binding Updated}" FontSize="10" Foreground="{DynamicResource Island.Subtle}" />
                    <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Island.Subtle}"
                               Margin="10,0,0,0" MaxWidth="260" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
