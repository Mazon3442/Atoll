<ResourceDictionary
    xmlns:shell="clr-namespace:Atoll.Shell" x:Class="Atoll.Modules.Stats.StatsTemplates" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate x:Key="Stats.Tile">
        <Border Style="{StaticResource Island.Card}" Padding="12,10" Margin="0,0,10,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="12"
                               Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Light" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" Height="15" />
                <!-- Points use a fixed 120×28 space; the Viewbox stretches it to the tile width. -->
                <Viewbox Stretch="Fill" Height="28" Margin="0,4,0,0">
                    <Grid Width="120" Height="28" ClipToBounds="True">
                        <Polygon Points="{Binding Sparkline}" Fill="{DynamicResource Island.Accent}" Opacity="0.25" />
                        <Polyline Points="{Binding Sparkline}" Stroke="{DynamicResource Island.Accent}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" />
                    </Grid>
                </Viewbox>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- The four readings. This is the element that starts and stops sampling, so it must stay on the page. -->
    <DataTemplate x:Key="StatsViewModel.Tiles">
        <UniformGrid Columns="4" Margin="0,0,-10,0" AutomationProperties.Name="System stats"
                     Loaded="OnViewVisible" IsVisibleChanged="OnViewVisible" DataContextChanged="OnViewVisible" Unloaded="OnViewUnloaded">
            <ContentPresenter Content="{Binding Cpu}" ContentTemplate="{StaticResource Stats.Tile}" />
            <ContentPresenter Content="{Binding Gpu}" ContentTemplate="{StaticResource Stats.Tile}" />
            <ContentPresenter Content="{Binding Memory}" ContentTemplate="{StaticResource Stats.Tile}" />
            <ContentPresenter Content="{Binding Network}" ContentTemplate="{StaticResource Stats.Tile}" />
        </UniformGrid>
    </DataTemplate>

    <!-- Bluetooth batteries: one chip per connected device. -->
    <DataTemplate x:Key="StatsViewModel.Chips">
        <ItemsControl ItemsSource="{Binding Devices}" AutomationProperties.Name="Bluetooth batteries">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="{shell:Round}" Padding="10,4" Margin="0,0,6,6" Background="{DynamicResource Island.Surface}"
                            AutomationProperties.Name="{Binding Description}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE702;" FontFamily="{StaticResource Island.IconFont}" FontSize="11"
                                       Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" FontSize="12" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock x:Name="Level" Text="{Binding Text}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsLow}" Value="True">
                            <Setter TargetName="Level" Property="Foreground" Value="#FF9F0A" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="StatsViewModel.Panel">
        <StackPanel VerticalAlignment="Center">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatsViewModel.Tiles}" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatsViewModel.Chips}" Margin="0,10,0,0" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
