<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell">

    <!-- A thumbnail or a colour swatch, or the tool's icon when it has neither. -->
    <DataTemplate x:Key="Screen.Lead">
        <Grid Width="44" Height="44">
            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasThumbnail, Converter={StaticResource Island.BoolToVisibility}}" />
            <Border Background="{Binding Swatch}" CornerRadius="{shell:Round 14}"
                    Visibility="{Binding HasSwatch, Converter={StaticResource Island.BoolToVisibility}}" />
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="20" Foreground="{DynamicResource Island.Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasThumbnail}" Value="False" />
                                    <Condition Binding="{Binding HasSwatch}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ScreenCardViewModel.Compact">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Title}">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ScreenCardViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Screen.Lead}" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" MaxWidth="300" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasDetail, Converter={StaticResource Island.BoolToVisibility}}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Actions}" Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Island.RoundButton}" Command="{Binding Command}" Margin="6,0,0,0" ToolTip="{Binding Label}"
                                AutomationProperties.Name="{Binding Label}">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="14" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- Recording: a red dot, the time, and Stop. -->
    <SolidColorBrush x:Key="Screen.Recording" Color="#FF453A" />

    <DataTemplate x:Key="RecordingViewModel.Compact">
        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Elapsed, StringFormat=Recording {0}}">
            <Ellipse Width="9" Height="9" Fill="{StaticResource Screen.Recording}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Elapsed}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock Text="MP4" FontSize="11" Foreground="{DynamicResource Island.Subtle}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource Island.PrimaryChip}" Content="Stop" Margin="14,0,0,0" MinHeight="22" Padding="10,2" Command="{Binding StopCommand}"
                    AutomationProperties.Name="Stop recording" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RecordingViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="12" Height="12" Fill="{StaticResource Screen.Recording}" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="Recording" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Elapsed}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
            </StackPanel>
            <Button Style="{StaticResource Island.PrimaryChip}" Content="Stop" Margin="0" Command="{Binding StopCommand}" AutomationProperties.Name="Stop recording" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RecordingViewModel.Mini">
        <Ellipse Width="9" Height="9" Fill="{StaticResource Screen.Recording}" ToolTip="Recording" AutomationProperties.Name="Recording" />
    </DataTemplate>

    <DataTemplate x:Key="ScreenCardViewModel.Mini">
        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="13" ToolTip="{Binding Title}"
                   AutomationProperties.Name="{Binding Title}" />
    </DataTemplate>

</ResourceDictionary>
