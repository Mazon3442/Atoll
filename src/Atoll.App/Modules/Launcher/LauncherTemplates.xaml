<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell"
                    xmlns:s="clr-namespace:Atoll.Settings">

    <!-- A pinned shortcut chip: the program's icon or an initial, and its name. -->
    <DataTemplate x:Key="Launcher.PinChip">
        <Button Style="{StaticResource Island.ChipButton}" Margin="0,0,6,6" Padding="8,4,12,4"
                Command="{Binding DataContext.Apps.Pins.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding Pin}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Edit" Command="{Binding PlacementTarget.Tag.Apps.Pins.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    <MenuItem Header="Remove" Command="{Binding PlacementTarget.Tag.Apps.Pins.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal">
                <Grid Width="20" Height="20" Margin="0,0,8,0">
                    <Border CornerRadius="{shell:Round}" Background="{DynamicResource Island.Hover}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="120" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="LauncherPanelViewModel.Panel">
        <StackPanel MinHeight="220">
            <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round}" Padding="3"
                    HorizontalAlignment="Left" Margin="0,0,0,10"
                    Visibility="{Binding ShowSwitch, Converter={StaticResource Island.BoolToVisibility}}">
                <ListBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource Island.SegmentItem}"
                         Background="Transparent" BorderThickness="0" FontSize="12"
                         Foreground="{DynamicResource Island.Subtle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Launcher section">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <!-- Apps -->
            <Grid Visibility="{Binding IsApps, Converter={StaticResource Island.BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Padding="10,5" Margin="0,0,0,4">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Island.IconButton}" Width="24" Height="24"
                                Margin="6,0,0,0" Command="{Binding Apps.RefreshCommand}" ToolTip="Scan the Start Menu again"
                                AutomationProperties.Name="Scan the Start Menu again">
                            <shell:Icon Kind="refresh" Size="13" />
                        </Button>
                        <Grid>
                            <TextBlock Text="Search apps" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Island.Subtle}"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Apps.HasSearch, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                            <TextBox Text="{Binding Apps.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{DynamicResource Island.Foreground}" CaretBrush="{DynamicResource Island.Foreground}"
                                     VerticalContentAlignment="Center" AutomationProperties.Name="Search apps">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding Apps.OpenFirstCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Your pinned shortcuts: a row of chips, groups that open a second row, and a plus to add one. -->
                <StackPanel Grid.Row="1" Margin="0,6,0,0" DataContext="{Binding}">
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding Apps.Pins.Slots}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ContentPresenter Content="{Binding Single}" ContentTemplate="{StaticResource Launcher.PinChip}">
                                            <ContentPresenter.Style>
                                                <Style TargetType="ContentPresenter">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsGroup, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentPresenter.Style>
                                        </ContentPresenter>
                                        <Button Margin="0,0,6,6" Padding="12,4" Command="{Binding ClickCommand}"
                                                AutomationProperties.Name="{Binding Label, StringFormat=Group {0}}">
                                            <Button.Content>
                                                <TextBlock Text="{Binding Label}" FontSize="12" />
                                            </Button.Content>
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Island.ChipButton}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGroup}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Island.ChipButton}" Margin="0,0,6,6" Padding="10,4" Command="{Binding Apps.Pins.StartAddCommand}"
                                ToolTip="Pin an app, file, site or link" AutomationProperties.Name="Pin a shortcut">
                            <shell:Icon Kind="plus" Size="13" />
                        </Button>
                    </WrapPanel>
                    <!-- The open group. -->
                    <ItemsControl ItemsSource="{Binding Apps.Pins.OpenChips}" Focusable="False" Margin="12,0,0,0"
                                  Visibility="{Binding Apps.Pins.HasOpenGroup, Converter={StaticResource Island.BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="Launcher.PinChip" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The form. -->
                    <Border Style="{StaticResource Island.Card}" Padding="12,10" Margin="0,2,0,6"
                            Visibility="{Binding Apps.Pins.FormOpen, Converter={StaticResource Island.BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Apps.Pins.FormTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBox Style="{StaticResource Island.Input}" Text="{Binding Apps.Pins.FormTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                     ToolTip="A path, a web address, or a link such as steam://run/570" AutomationProperties.Name="What to open" />
                            <UniformGrid Columns="3">
                                <TextBox Style="{StaticResource Island.Input}" Text="{Binding Apps.Pins.FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                                         ToolTip="Name (optional)" AutomationProperties.Name="Name" />
                                <TextBox Style="{StaticResource Island.Input}" Text="{Binding Apps.Pins.FormGroup, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,6"
                                         ToolTip="Group (optional): shortcuts with the same group share one chip" AutomationProperties.Name="Group" />
                                <TextBox Style="{StaticResource Island.Input}" Text="{Binding Apps.Pins.FormHotkey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"
                                         ToolTip="Hotkey (optional), for example Ctrl+Alt+1" AutomationProperties.Name="Hotkey" />
                            </UniformGrid>
                            <TextBlock Text="Fields: path or link, name, group, hotkey. Name, group and hotkey are optional." FontSize="11" Foreground="{DynamicResource Island.Subtle}" />
                            <TextBlock Text="{Binding Apps.Pins.FormError}" FontSize="11" Foreground="{DynamicResource Island.Accent}" TextWrapping="Wrap" Margin="0,4,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource Island.PrimaryChip}" Content="Save" Margin="0,0,6,0" Command="{Binding Apps.Pins.SaveFormCommand}" />
                                <Button Style="{StaticResource Island.ChipButton}" Content="Cancel" Margin="0" Command="{Binding Apps.Pins.CancelFormCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,6,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" MaxHeight="240">
                        <ItemsControl ItemsSource="{Binding Apps.FilteredApps}" Focusable="False" Margin="0,0,6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Island.RowButton}"
                                            Command="{Binding DataContext.Apps.LaunchCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Pin to the row above"
                                                          Command="{Binding PlacementTarget.Tag.Apps.PinCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0">
                                                <Border CornerRadius="{shell:Round 14}" Background="{DynamicResource Island.Surface}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Grid>
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding Apps.EmptyMessage}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Island.Subtle}"
                               Visibility="{Binding Apps.ShowEmpty, Converter={StaticResource Island.BoolToVisibility}}" />
                </Grid>
            </Grid>

            <!-- Games, unchanged from the old Games tab -->
            <ContentControl Content="{Binding Games}" ContentTemplate="{StaticResource GameViewModel.Panel}"
                            Visibility="{Binding IsGames, Converter={StaticResource Island.BoolToVisibility}}" />
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
