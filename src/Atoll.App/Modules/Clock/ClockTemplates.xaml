<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:shell="clr-namespace:Atoll.Shell">

    <!-- Clock -->
    <DataTemplate x:Key="ClockViewModel.Compact">
        <TextBlock Text="{Binding Time}" FontSize="13" FontWeight="SemiBold" />
    </DataTemplate>

    <DataTemplate x:Key="ClockViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Time}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Date}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Island.Subtle}" />
        </StackPanel>
    </DataTemplate>

    <!-- Timer as a live activity -->
    <DataTemplate x:Key="TimerViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Island.IconFont}" FontSize="13"
                       Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Display}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                       Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TimerViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE916;" FontFamily="{StaticResource Island.IconFont}" FontSize="20"
                       Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
                <TextBlock Text="{Binding Display}" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <Button Style="{StaticResource Island.IconButton}" Margin="16,0,0,0" Command="{Binding PauseResumeCommand}"
                    Visibility="{Binding IsAlarm, Converter={StaticResource Island.InverseBoolToVisibility}}"
                    AutomationProperties.Name="Pause or resume timer">
                <Button.Content>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE769;" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                        <Setter Property="Text" Value="&#xE768;" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.Content>
            </Button>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="TimerViewModel.Mini">
        <TextBlock Text="{Binding Display}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Island.Accent}" />
    </DataTemplate>

        <!-- Expanded tab: the clock, then either timer presets or the running timer. Top-aligned so nothing jumps when a timer starts. -->
    <DataTemplate x:Key="ClockPanelViewModel.Panel">
        <DataTemplate.Resources>
            <Style x:Key="Clock.Button" TargetType="Button" BasedOn="{StaticResource Island.ChipButton}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="2" />
            </Style>
            <Style x:Key="Clock.Step" TargetType="Button" BasedOn="{StaticResource Island.IconButton}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="FontSize" Value="12" />
            </Style>
        </DataTemplate.Resources>
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Clock.Time}" FontSize="32" FontWeight="Light"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Clock.Time}" />
                <!-- Timer and Pomodoro sit centred on the clock line; the date keeps the left edge. -->
                <Border Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" DataContext="{Binding Timer}"
                        Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round}" Padding="3"
                        Visibility="{Binding IsActive, Converter={StaticResource Island.InverseBoolToVisibility}}">
                    <ListBox ItemsSource="{Binding Sections}" SelectedIndex="{Binding SectionIndex, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Island.SegmentItem}"
                             Background="Transparent" BorderThickness="0" FontSize="11"
                             Foreground="{DynamicResource Island.Subtle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Timer mode">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Border>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Clock.Date}" FontSize="12"
                           Foreground="{DynamicResource Island.Subtle}" />
            </Grid>

            <!-- Timer idle: the selected section's controls. -->
            <StackPanel DataContext="{Binding Timer}"
                        Visibility="{Binding IsActive, Converter={StaticResource Island.InverseBoolToVisibility}}">
                <StackPanel x:Name="TimerSection" Visibility="{Binding IsTimerSection, Converter={StaticResource Island.BoolToVisibility}}">
                    <UniformGrid Columns="4" Margin="-2,0">
                        <Button Style="{StaticResource Clock.Button}" Content="1" Command="{Binding StartCountdownCommand}"
                                ToolTip="1 minute timer" AutomationProperties.Name="1 minute timer">
                            <Button.CommandParameter><sys:Double>1</sys:Double></Button.CommandParameter>
                        </Button>
                        <Button Style="{StaticResource Clock.Button}" Content="5" Command="{Binding StartCountdownCommand}"
                                ToolTip="5 minute timer" AutomationProperties.Name="5 minute timer">
                            <Button.CommandParameter><sys:Double>5</sys:Double></Button.CommandParameter>
                        </Button>
                        <Button Style="{StaticResource Clock.Button}" Content="10" Command="{Binding StartCountdownCommand}"
                                ToolTip="10 minute timer" AutomationProperties.Name="10 minute timer">
                            <Button.CommandParameter><sys:Double>10</sys:Double></Button.CommandParameter>
                        </Button>
                        <Button Style="{StaticResource Clock.Button}" Content="30" Command="{Binding StartCountdownCommand}"
                                ToolTip="30 minute timer" AutomationProperties.Name="30 minute timer">
                            <Button.CommandParameter><sys:Double>30</sys:Double></Button.CommandParameter>
                        </Button>
                    </UniformGrid>
                    <!-- Any length: step or type the minutes, then Start. Same stepper as the Pomodoro rows. -->
                    <DockPanel Margin="2,2,2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Clock.Button}" Content="Start" Command="{Binding StartCustomCommand}"
                                ToolTip="Start a timer of this length" AutomationProperties.Name="Start a timer of the chosen minutes" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Clock.Step}" Content="&#xE738;" Command="{Binding SubtractCustomMinuteCommand}"
                                    ToolTip="One minute less" AutomationProperties.Name="Decrease timer minutes" />
                            <TextBox Style="{StaticResource Island.Input}" Width="44" Height="28" Padding="0" Margin="4,0" FontSize="13" FontWeight="SemiBold"
                                     TextAlignment="Center" VerticalContentAlignment="Center"
                                     Text="{Binding CustomMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Minutes. Type a number or use the buttons." AutomationProperties.Name="Timer minutes" />
                            <Button Style="{StaticResource Clock.Step}" Content="&#xE710;" Command="{Binding AddCustomMinuteCommand}"
                                    ToolTip="One minute more" AutomationProperties.Name="Increase timer minutes" />
                            <TextBlock Text="min" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Island.Subtle}" />
                        </StackPanel>
                    </DockPanel>
                    <Button Style="{StaticResource Clock.Button}" Content="Stopwatch" Command="{Binding StartStopwatchCommand}"
                            HorizontalAlignment="Left" Margin="2,2,2,0" />
                </StackPanel>
                <!-- Alarm: set the hour, the minute and am/pm, then Set. It rings at that time, today or tomorrow. -->
                <StackPanel x:Name="AlarmSection" Visibility="{Binding IsAlarmSection, Converter={StaticResource Island.BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                        <StackPanel>
                            <Button Style="{StaticResource Clock.Step}" Content="&#xE70E;" Command="{Binding AddAlarmHourCommand}" Width="56"
                                    ToolTip="Later hour" AutomationProperties.Name="Later hour" />
                            <TextBlock Text="{Binding AlarmHourText}" FontSize="32" FontWeight="Light" TextAlignment="Center" Margin="0,2"
                                       AutomationProperties.Name="Alarm hour" />
                            <Button Style="{StaticResource Clock.Step}" Content="&#xE70D;" Command="{Binding SubtractAlarmHourCommand}" Width="56"
                                    ToolTip="Earlier hour" AutomationProperties.Name="Earlier hour" />
                        </StackPanel>
                        <TextBlock Text=":" FontSize="32" FontWeight="Light" VerticalAlignment="Center" Margin="4,0" />
                        <StackPanel>
                            <Button Style="{StaticResource Clock.Step}" Content="&#xE70E;" Command="{Binding AddAlarmMinuteCommand}" Width="56"
                                    ToolTip="Later minute" AutomationProperties.Name="Later minute" />
                            <TextBlock Text="{Binding AlarmMinuteText}" FontSize="32" FontWeight="Light" TextAlignment="Center" Margin="0,2"
                                       AutomationProperties.Name="Alarm minute" />
                            <Button Style="{StaticResource Clock.Step}" Content="&#xE70D;" Command="{Binding SubtractAlarmMinuteCommand}" Width="56"
                                    ToolTip="Earlier minute" AutomationProperties.Name="Earlier minute" />
                        </StackPanel>
                        <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round}" Padding="3" Margin="18,0,0,0" VerticalAlignment="Center">
                            <ListBox SelectedIndex="{Binding AlarmPmIndex, Mode=TwoWay}" ItemContainerStyle="{StaticResource Island.SegmentItem}"
                                     Background="Transparent" BorderThickness="0" FontSize="11" Foreground="{DynamicResource Island.Subtle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="AM or PM">
                                <ListBoxItem Content="AM" />
                                <ListBoxItem Content="PM" />
                            </ListBox>
                        </Border>
                    </StackPanel>
                    <DockPanel Margin="2,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Clock.Button}" Content="Set alarm" Command="{Binding StartAlarmCommand}"
                                AutomationProperties.Name="Set the alarm" />
                        <TextBlock Text="{Binding AlarmSummary}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Island.Subtle}" />
                    </DockPanel>
                </StackPanel>

                <!-- Pomodoro: three sessions you can start, each with its length; then how the days have gone. -->
                <StackPanel x:Name="PomodoroSection" Visibility="{Binding IsPomodoroSection, Converter={StaticResource Island.BoolToVisibility}}">
                    <DockPanel Margin="0,2,0,10">
                        <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="{shell:Round 14}" Margin="0,0,12,0"
                                Background="{DynamicResource Island.Surface}">
                            <shell:Icon Kind="timer" Size="22" Foreground="{DynamicResource Island.Accent}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="POMODORO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Island.Subtle}" />
                            <TextBlock Text="Stay in flow" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Margin="0,0,0,6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button Style="{StaticResource Clock.Step}" Content="&#xE738;" Command="{Binding SubtractFocusCommand}"
                                        ToolTip="Five minutes less" AutomationProperties.Name="Decrease focus length" />
                                <TextBlock Text="{Binding FocusMinutes, StringFormat={}{0} min}" FontSize="13" FontWeight="SemiBold"
                                           MinWidth="58" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Clock.Step}" Content="&#xE710;" Command="{Binding AddFocusCommand}"
                                        ToolTip="Five minutes more" AutomationProperties.Name="Increase focus length" />
                            </StackPanel>
                            <Button Style="{StaticResource Island.RowButton}" Command="{Binding StartPomodoroCommand}"
                                    ToolTip="{Binding PomodoroStartLabel}" AutomationProperties.Name="Start Pomodoro">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0">
                                        <Ellipse Fill="{DynamicResource Island.Accent}" Opacity="0.2" />
                                        <shell:Icon Kind="timer" Size="16" Foreground="{DynamicResource Island.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Focus" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Deep work" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Margin="0,0,0,6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button Style="{StaticResource Clock.Step}" Content="&#xE738;" Command="{Binding SubtractShortBreakCommand}"
                                        ToolTip="One minute less" AutomationProperties.Name="Decrease short break" />
                                <TextBlock Text="{Binding ShortBreakMinutes, StringFormat={}{0} min}" FontSize="13" FontWeight="SemiBold"
                                           MinWidth="58" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Clock.Step}" Content="&#xE710;" Command="{Binding AddShortBreakCommand}"
                                        ToolTip="One minute more" AutomationProperties.Name="Increase short break" />
                            </StackPanel>
                            <Button Style="{StaticResource Island.RowButton}" Command="{Binding StartBreakCommand}"
                                    ToolTip="Start a short break" AutomationProperties.Name="Start a break">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0">
                                        <Ellipse Fill="#32D74B" Opacity="0.2" />
                                        <shell:Icon Kind="coffee" Size="16" Foreground="#32D74B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Break" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="Step away" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 14}" Margin="0,0,0,6">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Button Style="{StaticResource Clock.Step}" Content="&#xE738;" Command="{Binding SubtractLongBreakCommand}"
                                        ToolTip="Five minutes less" AutomationProperties.Name="Decrease long break" />
                                <TextBlock Text="{Binding LongBreakMinutes, StringFormat={}{0} min}" FontSize="13" FontWeight="SemiBold"
                                           MinWidth="58" TextAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Clock.Step}" Content="&#xE710;" Command="{Binding AddLongBreakCommand}"
                                        ToolTip="Five minutes more" AutomationProperties.Name="Increase long break" />
                            </StackPanel>
                            <Button Style="{StaticResource Island.RowButton}" Command="{Binding StartLongBreakCommand}"
                                    ToolTip="Start a long break" AutomationProperties.Name="Start a long break">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0">
                                        <Ellipse Fill="#32D74B" Opacity="0.2" />
                                        <shell:Icon Kind="coffee" Size="16" Foreground="#32D74B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Long break" FontSize="14" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="After" FontSize="12" Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource Clock.Step}" Width="20" Height="20" Content="&#xE738;" Margin="4,0,0,0"
                                                    Command="{Binding SubtractSessionCommand}" ToolTip="One session less"
                                                    AutomationProperties.Name="Decrease sessions before long break" />
                                            <TextBlock Text="{Binding SessionsBeforeLongBreak, StringFormat={}{0} sessions}" FontSize="12"
                                                       MinWidth="66" TextAlignment="Center" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource Clock.Step}" Width="20" Height="20" Content="&#xE710;"
                                                    Command="{Binding AddSessionCommand}" ToolTip="One session more"
                                                    AutomationProperties.Name="Increase sessions before long break" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                    <UniformGrid Columns="3" Margin="0,4,-6,0">
                        <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 22}" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <shell:Icon Kind="circle-check" Size="13" Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TodayFocus}" FontSize="13" FontWeight="SemiBold" Margin="7,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="today" FontSize="12" Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 22}" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <shell:Icon Kind="flame" Size="13" Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FocusStreak}" FontSize="13" FontWeight="SemiBold" Margin="7,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="streak" FontSize="12" Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 22}" Padding="10,8" Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <shell:Icon Kind="trending-up" Size="13" Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalFocus}" FontSize="13" FontWeight="SemiBold" Margin="7,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="total" FontSize="12" Foreground="{DynamicResource Island.Subtle}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>

            <!-- Timer running: the time, with its controls beside it and progress underneath. -->
            <Border DataContext="{Binding Timer}" Background="{DynamicResource Island.Surface}" CornerRadius="{shell:Round 22}" Padding="12,8,6,10"
                    Visibility="{Binding IsActive, Converter={StaticResource Island.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource Island.Subtle}" />
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding PauseResumeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Island.IconButton}">
                                        <Setter Property="Content" Value="&#xE769;" />
                                        <Setter Property="ToolTip" Value="Pause" />
                                        <Setter Property="AutomationProperties.Name" Value="Pause timer" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlarm}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                <Setter Property="Content" Value="&#xE768;" />
                                                <Setter Property="ToolTip" Value="Resume" />
                                                <Setter Property="AutomationProperties.Name" Value="Resume timer" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource Island.ChipButton}" Content="+1m" Command="{Binding AddMinuteCommand}"
                                    MinHeight="32" Margin="2,0" ToolTip="Add a minute" AutomationProperties.Name="Add a minute"
                                    Visibility="{Binding IsCountingDown, Converter={StaticResource Island.BoolToVisibility}}" />
                            <Button Style="{StaticResource Island.IconButton}" Content="&#xE71A;" Command="{Binding ResetCommand}"
                                    ToolTip="Stop" AutomationProperties.Name="Stop timer" />
                        </StackPanel>
                        <TextBlock Text="{Binding Display}" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Island.Accent}" />
                    </DockPanel>
                    <Grid Height="4" Margin="0,0,6,0"
                          Visibility="{Binding IsCountingDown, Converter={StaticResource Island.BoolToVisibility}}">
                        <Border CornerRadius="{shell:Round}" Background="{DynamicResource Island.Hover}" />
                        <Border CornerRadius="{shell:Round}" Background="{DynamicResource Island.Accent}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding Progress}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
