<Window x:Class="Atoll.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atoll settings"
        Width="560" Height="720" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        ThemeMode="System">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style x:Key="RowLabel" TargetType="Label">
            <Setter Property="Width" Value="150" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,24">

            <!-- General -->
            <TextBlock Style="{StaticResource Section}" Text="General" />
            <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,4" />
            <CheckBox Content="Hide in fullscreen apps and games" IsChecked="{Binding HideInFullscreen}" Margin="0,4" />
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Hover delay" Target="{Binding ElementName=HoverDelay}" />
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding HoverDelayMs, StringFormat={}{0} ms}" />
                <Slider x:Name="HoverDelay" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True"
                        Value="{Binding HoverDelayMs}" />
            </DockPanel>

            <!-- Display -->
            <TextBlock Style="{StaticResource Section}" Text="Display" />
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Show on" Target="{Binding ElementName=MonitorModeBox}" />
                <ComboBox x:Name="MonitorModeBox" ItemsSource="{Binding MonitorModes}" SelectedItem="{Binding MonitorMode}" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Displays}" Margin="150,0,0,0"
                          Visibility="{Binding IsSelectedMode, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Top gap" Target="{Binding ElementName=TopOffset}" />
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding TopOffset, StringFormat={}{0:0} px}" />
                <Slider x:Name="TopOffset" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding TopOffset}" />
            </DockPanel>

            <!-- Theme -->
            <TextBlock Style="{StaticResource Section}" Text="Theme" />
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Preset" Target="{Binding ElementName=Preset}" />
                <ComboBox x:Name="Preset" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Background" Target="{Binding ElementName=BgColor}" />
                <Border DockPanel.Dock="Right" Width="28" Height="28" CornerRadius="6" Margin="8,0,0,0"
                        BorderBrush="Gray" BorderThickness="1" Background="{Binding Background}" />
                <TextBox x:Name="BgColor" Text="{Binding Background, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Text" Target="{Binding ElementName=FgColor}" />
                <Border DockPanel.Dock="Right" Width="28" Height="28" CornerRadius="6" Margin="8,0,0,0"
                        BorderBrush="Gray" BorderThickness="1" Background="{Binding Foreground}" />
                <TextBox x:Name="FgColor" Text="{Binding Foreground, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Accent" Target="{Binding ElementName=AccentColor}" />
                <Border DockPanel.Dock="Right" Width="28" Height="28" CornerRadius="6" Margin="8,0,0,0"
                        BorderBrush="Gray" BorderThickness="1" Background="{Binding Accent}" />
                <TextBox x:Name="AccentColor" Text="{Binding Accent, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Opacity" Target="{Binding ElementName=OpacitySlider}" />
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding Opacity, StringFormat={}{0:P0}}" />
                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" Value="{Binding Opacity}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Island height" Target="{Binding ElementName=CompactHeight}" />
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding CompactHeight, StringFormat={}{0:0} px}" />
                <Slider x:Name="CompactHeight" Minimum="24" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding CompactHeight}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="_Roundness" Target="{Binding ElementName=Roundness}" />
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding Roundness, StringFormat={}{0:P0}}" />
                <Slider x:Name="Roundness" Minimum="0" Maximum="1" Value="{Binding Roundness}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="Expanded _width" Target="{Binding ElementName=ExpandedWidth}" />
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding ExpandedWidth, StringFormat={}{0:0} px}" />
                <Slider x:Name="ExpandedWidth" Minimum="320" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding ExpandedWidth}" />
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <Label Style="{StaticResource RowLabel}" Content="Expanded h_eight" Target="{Binding ElementName=ExpandedHeight}" />
                <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding ExpandedHeight, StringFormat={}{0:0} px}" />
                <Slider x:Name="ExpandedHeight" Minimum="140" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True"
                        Value="{Binding ExpandedHeight}" />
            </DockPanel>

            <!-- Claude Code -->
            <TextBlock Style="{StaticResource Section}" Text="Claude Code" />
            <TextBlock Text="{Binding HookStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8">
                Live activity comes from Claude Code hooks. Installing adds entries to
                <Run Text="{Binding HookSettingsPath, Mode=OneWay}" />; your other settings and hooks are kept.
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Install hooks" Command="{Binding InstallHooksCommand}" Margin="0,0,8,0" Padding="14,6" />
                <Button Content="Remove hooks" Command="{Binding RemoveHooksCommand}" Padding="14,6" />
            </StackPanel>
            <TextBlock Text="{Binding HookMessage}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
            <CheckBox Content="Play a sound when a session finishes" IsChecked="{Binding SoundOnDone}" Margin="0,4" />
            <CheckBox Content="Play a sound when a session needs permission" IsChecked="{Binding SoundOnAttention}" Margin="0,4" />

            <!-- Modules -->
            <TextBlock Style="{StaticResource Section}" Text="Modules" />
            <TextBlock Text="Order here is the tab order in the expanded island." Opacity="0.7" Margin="0,0,0,8" />
            <ItemsControl x:Name="ModuleList" ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3">
                            <Button DockPanel.Dock="Right" Content="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    ToolTip="Move down" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}"
                                    Command="{Binding DataContext.MoveDownCommand, ElementName=ModuleList}"
                                    CommandParameter="{Binding}" Margin="4,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                    ToolTip="Move up" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}"
                                    Command="{Binding DataContext.MoveUpCommand, ElementName=ModuleList}"
                                    CommandParameter="{Binding}" Margin="8,0,0,0" />
                            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Window>
