<Window x:Class="Atoll.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Atoll.Settings"
        xmlns:weather="clr-namespace:Atoll.Modules.Weather"
        Title="ATOLL settings" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        Width="1040" Height="780" MinWidth="760" MinHeight="480"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        WindowStartupLocation="CenterScreen" Icon="/Atoll;component/Assets/Atoll.ico"
        ThemeMode="System">

    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/Atoll;component/Theme/Scrollbars.xaml" />
            <ResourceDictionary Source="/Atoll;component/Theme/Logo.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource Atoll.ScrollBar}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="SettingsFocus" TargetType="Control">
            <Setter Property="Template"><Setter.Value><ControlTemplate>
                <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="6" Margin="-3" />
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <s:PageVisibilityConverter x:Key="PageVisible" />
        <s:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,26,0,10" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!-- Settings row: icon, title + description, control on the right (Windows 11 Settings layout). -->
        <Style TargetType="s:SettingCard">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="s:SettingCard">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" MinHeight="72">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="18" VerticalAlignment="Center" Margin="2,0,18,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{TemplateBinding Header}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                               Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource EmptyToCollapsed}}" />
                                </StackPanel>
                                <ContentPresenter x:Name="Editor" Grid.Column="2" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Editor" Property="Grid.Row" Value="1" />
                                <Setter TargetName="Editor" Property="Grid.Column" Value="1" />
                                <Setter TargetName="Editor" Property="Grid.ColumnSpan" Value="2" />
                                <Setter TargetName="Editor" Property="Margin" Value="0,12,0,0" />
                                <Setter TargetName="Editor" Property="HorizontalAlignment" Value="Left" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- On/off switch for CheckBox (WPF has no ToggleSwitch). -->
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                            <TextBlock x:Name="State" Text="Off" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="22" />
                            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" Background="Transparent">
                                <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="State" Property="Text" Value="On" />
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="Width" Value="14" />
                                <Setter TargetName="Knob" Property="Height" Value="14" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.75" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Star switch: on pins the feature's tab to the island's top row. -->
        <Style x:Key="BookmarkToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="Outline" Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="Filled" Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outline" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Filled" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Width" Value="56" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Sidebar entries. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" CornerRadius="8" Padding="14,12" Background="Transparent">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme gallery tile. -->
        <Style x:Key="ThemeTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Width="150" CornerRadius="8" BorderThickness="2" Padding="6"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Shape choice: a card with a small drawing; the top line is the screen edge. -->
        <Style x:Key="ShapeOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" Width="220" CornerRadius="8" BorderThickness="2" Padding="12"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.7" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="12,20,12,16">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,0,22">
                <!-- The hairline keeps the paper tile visible on a light sidebar. -->
                <Border Width="30" Height="30" CornerRadius="6.6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Image Source="{StaticResource Atoll.LogoSmall}" AutomationProperties.Name="ATOLL logo" />
                </Border>
                <TextBlock Text="ATOLL" FontSize="17" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Settings" Style="{StaticResource Hint}" Margin="14,12,0,0" />
            <ListBox ItemsSource="{Binding Pages}" SelectedIndex="{Binding PageIndex}" ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="OnPageChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0" Background="Transparent" AutomationProperties.Name="Settings sections">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,14,0" />
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        </Border>

        <!-- Page -->
        <DockPanel Grid.Column="1">
            <StackPanel DockPanel.Dock="Top" Margin="28,26,28,12">
                <TextBlock Text="{Binding PageTitle}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{Binding PageDescription}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
            </StackPanel>
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                <Grid Margin="28,0,22,28" MaxWidth="860" HorizontalAlignment="Stretch">

                    <!-- ===================== General ===================== -->
                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=0}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />
                        <s:SettingCard Glyph="&#xE7E8;" Header="Start with Windows" Description="Open ATOLL automatically when you sign in.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="When to show ATOLL" />
                        <s:SettingCard Glyph="&#xE740;" Header="Over fullscreen apps"
                                       Description="Videos, presentations and F11 browsers. Games always hide ATOLL.">
                            <ComboBox Width="250" ItemsSource="{Binding FullscreenModes}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding FullscreenMode}" AutomationProperties.Name="Over fullscreen apps" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE922;" Header="Over maximized windows"
                                       Description="Any app window that fills the screen above the taskbar.">
                            <ComboBox Width="250" ItemsSource="{Binding FullscreenModes}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding MaximizedMode}" AutomationProperties.Name="Over maximized windows" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE7B3;" Header="Hide when there's nothing to show"
                                       Description="No music, timers, agents or notifications? ATOLL gets out of the way.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding HideWhenIdle}" AutomationProperties.Name="Hide when there's nothing to show" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE7C9;" Header="Hold to bring it back"
                                       Description="While ATOLL is hidden, hold the pointer at the top of the screen, near where it sits. A line fills in; when it's full, ATOLL opens.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="0.5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                        Value="{Binding RevealHoldSeconds}" AutomationProperties.Name="Hold to bring it back" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding RevealHoldSeconds, StringFormat={}{0:0.0} s}" />
                            </StackPanel>
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Pointer" />
                        <s:SettingCard Glyph="&#xE916;" Header="Hover delay" Description="How long to rest the pointer on ATOLL before it opens.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True"
                                        Value="{Binding HoverDelayMs}" AutomationProperties.Name="Hover delay" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding HoverDelayMs, StringFormat={}{0} ms}" />
                            </StackPanel>
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE8B0;" Header="Click through over maximized windows"
                                       Description="Clicks on ATOLL reach the maximized app behind it, like its browser tabs. Rest the pointer on ATOLL to use it.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ClickThrough}" AutomationProperties.Name="Click through over maximized windows" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Keyboard" />
                        <s:SettingCard Glyph="&#xE765;" Header="Open ATOLL"
                                       Description="Opens the island from any app, ready for the keyboard. Press it again or Esc to close it.">
                            <s:HotkeyBox Shortcut="{Binding OpenShortcut}" AutomationProperties.Name="Shortcut to open ATOLL" />
                        </s:SettingCard>
                        <TextBlock Text="{Binding OpenShortcutStatus}" Style="{StaticResource Hint}" Margin="4,-2,0,8"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive"
                                   Visibility="{Binding OpenShortcutStatus, Converter={StaticResource EmptyToCollapsed}}" />
                        <s:SettingCard Glyph="&#xED1A;" Header="Hide or show ATOLL" Description="The same as Hide island in the tray menu.">
                            <s:HotkeyBox Shortcut="{Binding HideShortcut}" AutomationProperties.Name="Shortcut to hide or show ATOLL" />
                        </s:SettingCard>
                        <TextBlock Text="{Binding HideShortcutStatus}" Style="{StaticResource Hint}" Margin="4,-2,0,8"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive"
                                   Visibility="{Binding HideShortcutStatus, Converter={StaticResource EmptyToCollapsed}}" />
                        <s:SettingCard Glyph="&#xE721;" Header="Command palette"
                                       Description="Search tabs, apps and actions from any app. Ctrl+1 to 9 also jump to a bookmarked tab.">
                            <s:HotkeyBox Shortcut="{Binding PaletteShortcut}" AutomationProperties.Name="Shortcut for the command palette" />
                        </s:SettingCard>
                        <TextBlock Text="{Binding PaletteShortcutStatus}" Style="{StaticResource Hint}" Margin="4,-2,0,8"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive"
                                   Visibility="{Binding PaletteShortcutStatus, Converter={StaticResource EmptyToCollapsed}}" />
                        <TextBlock Text="{Binding ShortcutMessage}" Style="{StaticResource Hint}" Margin="4,-2,0,8" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding ShortcutMessage, Converter={StaticResource EmptyToCollapsed}}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="4,2,0,0"
                                   Text="Click a shortcut and press new keys to change it. Backspace turns it off. In the open island, Ctrl+Tab or the mouse wheel over the tabs switches sections." />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Position" />
                        <s:SettingCard Glyph="&#xE7F4;" Header="Show on" Description="Which displays get an island.">
                            <ComboBox Width="250" ItemsSource="{Binding MonitorModes}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding MonitorMode}" AutomationProperties.Name="Show on" />
                        </s:SettingCard>
                        <Border Visibility="{Binding IsSelectedMode, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="52,10,16,10">
                            <ItemsControl ItemsSource="{Binding Displays}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Appearance ===================== -->
                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=1}">
                        <!-- Live preview -->
                        <Border CornerRadius="12" Height="190" Margin="0,8,0,0" ClipToBounds="True" AutomationProperties.Name="Live theme preview">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#243544" Offset="0" />
                                    <GradientStop Color="#617488" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock Text="Live preview" Foreground="White" FontSize="12" Margin="16,14" VerticalAlignment="Bottom" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="{Binding PreviewTopGap}">
                                    <!-- Compact -->
                                    <Border Background="{Binding PreviewFill}" CornerRadius="{Binding PreviewCorner}" Height="{Binding PreviewHeight}"
                                            MinWidth="{Binding PreviewWidth}"
                                            BorderBrush="{Binding PreviewRim}" BorderThickness="{Binding PreviewRimThickness}" Padding="16,0" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#x273B;" FontFamily="Segoe UI Symbol" Foreground="#D97757" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="Editing App.xaml" Foreground="{Binding PreviewText}" FontSize="12" FontWeight="SemiBold"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Peek -->
                                    <Border Background="{Binding PreviewFill}" CornerRadius="{Binding PreviewPeekCorner}" BorderBrush="{Binding PreviewRim}"
                                            BorderThickness="1" Padding="14,10" Margin="0,14,0,0" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" CornerRadius="8" Background="{Binding PreviewAccent}" />
                                            <StackPanel Margin="12,0,18,0" VerticalAlignment="Center">
                                                <TextBlock Text="Midnight City" Foreground="{Binding PreviewText}" FontSize="14" FontWeight="SemiBold" />
                                                <TextBlock Text="M83" Foreground="{Binding PreviewSubtle}" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Rectangle Width="3" Height="8" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding PreviewAccent}" />
                                                <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding PreviewAccent}" />
                                                <Rectangle Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding PreviewAccent}" />
                                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding PreviewAccent}" />
                                                <Rectangle Width="3" Height="6" RadiusX="1.5" RadiusY="1.5" Margin="1,0" Fill="{Binding PreviewAccent}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Shape" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <RadioButton Style="{StaticResource ShapeOption}" GroupName="Shape" IsChecked="{Binding IsPill}"
                                         AutomationProperties.Name="Pill shape: floats below the top of the screen">
                                <StackPanel>
                                    <Grid Height="40">
                                        <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Border Width="84" Height="20" CornerRadius="10" Background="Black" Margin="0,10,0,0" VerticalAlignment="Top" />
                                    </Grid>
                                    <TextBlock Text="Pill" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="Floats just below the top of the screen." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ShapeOption}" GroupName="Shape" IsChecked="{Binding IsNotch}"
                                         AutomationProperties.Name="Notch shape: attached to the top of the screen">
                                <StackPanel>
                                    <Grid Height="40">
                                        <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Border Width="84" Height="22" CornerRadius="0,0,11,11" Background="Black" VerticalAlignment="Top" />
                                    </Grid>
                                    <TextBlock Text="Notch" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <TextBlock Text="Hangs from the top edge, like a laptop notch." Style="{StaticResource Hint}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <s:SettingCard Glyph="&#xE74A;" Header="Gap from the top of the screen" Description="Only for the pill. The notch always touches the edge."
                                       Visibility="{Binding IsPill, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding TopOffset}" AutomationProperties.Name="Gap from the top of the screen" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding TopOffset, StringFormat={}{0:0} px}" />
                            </StackPanel>
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE91F;" Header="Roundness" Description="0% gives square corners, 100% fully round ones. A notch rounds only its bottom corners.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="0" Maximum="1" Value="{Binding Roundness}" AutomationProperties.Name="Roundness" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding Roundness, StringFormat={}{0:P0}}" />
                            </StackPanel>
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE81E;" Header="Outline" Description="A thin rim that separates the island from what is behind it.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Outline}" AutomationProperties.Name="Outline" />
                        </s:SettingCard>

                        <Expander Margin="0,16,0,0" AutomationProperties.Name="Theme presets">
                            <Expander.Header><TextBlock Text="Theme presets" FontSize="15" FontWeight="SemiBold" /></Expander.Header>
                        <ItemsControl x:Name="ThemeGallery" ItemsSource="{Binding Themes}" Margin="0,12,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ThemeTile}" Command="{Binding DataContext.ApplyThemeCommand, ElementName=ThemeGallery}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Preset.Name, StringFormat=Use theme {0}}">
                                        <StackPanel>
                                            <Border Height="44" CornerRadius="5" Background="{Binding Preset.Background}"
                                                    BorderBrush="#22808080" BorderThickness="1">
                                                <Grid Margin="10,0">
                                                    <TextBlock Text="Aa" Foreground="{Binding Preset.Foreground}" FontWeight="SemiBold"
                                                               FontSize="15" VerticalAlignment="Center" />
                                                    <Ellipse Width="12" Height="12" Fill="{Binding Preset.Accent}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </Border>
                                            <DockPanel Margin="2,6,0,0">
                                                <TextBlock DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                                           AutomationProperties.Name="Selected theme"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                                                <Button DockPanel.Dock="Right" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                        FontSize="11" Padding="4" Margin="4,0,0,0" ToolTip="Delete this theme"
                                                        Command="{Binding DataContext.DeleteThemeCommand, ElementName=ThemeGallery}" CommandParameter="{Binding}"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="{Binding Preset.Name, StringFormat=Delete theme {0}}" />
                                                <TextBlock DockPanel.Dock="Right" Text="Glass" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Visibility="{Binding Preset.Glass, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Preset.Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Expander>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Colors" />
                        <s:SettingCard Glyph="&#xE790;" Header="Background" Description="The island's fill and glass tint.">
                            <s:ColorPicker Value="{Binding Background}" Label="Background color" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE8D2;" Header="Text">
                            <s:ColorPicker Value="{Binding Foreground}" Label="Text color" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE771;" Header="Accent" Description="Used for timers, the visualizer, and buttons.">
                            <s:ColorPicker Value="{Binding Accent}" Label="Accent color" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xF5EF;" Header="Frosted glass"
                                       Description="Blurs what is behind ATOLL, tinted with the background color. ATOLL falls back to a captured blur when the system cannot blur the island.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Glass}" AutomationProperties.Name="Frosted glass" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE706;" Header="Background opacity" Description="Scales the background color's own opacity.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="0.3" Maximum="1" Value="{Binding Opacity}" AutomationProperties.Name="Opacity" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding Opacity, StringFormat={}{0:P0}}" />
                            </StackPanel>
                        </s:SettingCard>

                        <s:SettingCard Glyph="&#xE74E;" Header="Save as a theme"
                                       Description="Save these colors and the glass setting. An existing name replaces that theme.">
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="180" Text="{Binding NewThemeName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="New theme name" />
                                <Button Content="Save" Margin="8,0,0,0" Padding="16,5" Command="{Binding SaveThemeCommand}" IsDefault="False" />
                            </StackPanel>
                        </s:SettingCard>
                        <TextBlock Text="{Binding ThemeMessage}" Style="{StaticResource Hint}" Margin="4,2,0,0"
                                   Visibility="{Binding ThemeMessage, Converter={StaticResource EmptyToCollapsed}}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Size" />
                        <s:SettingCard Glyph="&#xE740;" Header="Island height">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="24" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding CompactHeight}" AutomationProperties.Name="Island height" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding CompactHeight, StringFormat={}{0:0} px}" />
                            </StackPanel>
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE9A6;" Header="Resting width" Description="The narrowest the island gets. Longer text still widens it.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="60" Maximum="400" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding CompactWidth}" AutomationProperties.Name="Resting width" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding CompactWidth, StringFormat={}{0:0} px}" />
                            </StackPanel>
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE9A6;" Header="Expanded width" Description="Size of the panel when you click ATOLL.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="320" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding ExpandedWidth}" AutomationProperties.Name="Expanded width" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding ExpandedWidth, StringFormat={}{0:0} px}" />
                            </StackPanel>
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE9A6;" Header="Expanded height">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="140" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding ExpandedHeight}" AutomationProperties.Name="Expanded height" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding ExpandedHeight, StringFormat={}{0:0} px}" />
                            </StackPanel>
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Behavior" />
                        <s:SettingCard Glyph="&#xE945;" Header="Motion" Description="How the island grows and shrinks. Turning off animation effects in Windows also turns this off.">
                            <ComboBox Width="250" ItemsSource="{Binding MotionStyles}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding Motion}" AutomationProperties.Name="Motion" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE8A9;" Header="Show other activities beside the island"
                                       Description="Small bubbles for things running in the background, like a timer while music plays.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowSideActivities}" AutomationProperties.Name="Show other activities beside the island" />
                        </s:SettingCard>
                    </StackPanel>

                    <!-- ===================== Modules ===================== -->
                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=2}">
                        <TextBlock Style="{StaticResource Hint}" Margin="2,8,0,10"
                                   Text="Each card is one tab. The star bookmarks the whole tab in the top row. The switch turns the whole tab off. Switches inside a card fine-tune its parts. Drag a card or use its arrows to reorder." />

                        <ItemsControl x:Name="ModuleList" ItemsSource="{Binding ModuleTabs}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Padding="6,8,16,8" Margin="0,0,0,8" CornerRadius="10" BorderThickness="1"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            AllowDrop="True" DragOver="OnModuleDragOver" DragLeave="OnModuleDragLeave" Drop="OnModuleDrop">
                                        <StackPanel>
                                            <Grid MinHeight="44">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Content="&#xE76F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="8,10" Margin="0,0,8,0"
                                                        Cursor="SizeAll" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"
                                                        ToolTip="Drag to move this tab. Alt + Up or Down also moves it."
                                                        PreviewMouseLeftButtonDown="OnModuleDragStart" PreviewMouseMove="OnModuleDragMove" PreviewKeyDown="OnModuleKeyDown"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Move the {0} tab}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                                           VerticalAlignment="Center" Margin="0,0,14,0" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                                    <TextBlock x:Name="Status" Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,2,0,0"
                                                               Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="Up" Content="&#xE70E;" Command="{Binding DataContext.MoveTabUpCommand, ElementName=ModuleList}" CommandParameter="{Binding}"
                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Width="34" Height="32" Padding="0"
                                                            ToolTip="Move up" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}" />
                                                    <Button x:Name="Down" Content="&#xE70D;" Command="{Binding DataContext.MoveTabDownCommand, ElementName=ModuleList}" CommandParameter="{Binding}"
                                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Width="34" Height="32" Padding="0" Margin="4,0,0,0"
                                                            ToolTip="Move down" AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}" />
                                                </StackPanel>
                                                <ToggleButton x:Name="OnlyBookmark" Grid.Column="4" Style="{StaticResource BookmarkToggle}" Margin="16,0,0,0" VerticalAlignment="Center"
                                                              IsChecked="{Binding Bookmarked}" ToolTip="Bookmark this tab in the top row"
                                                              AutomationProperties.Name="{Binding Name, StringFormat=Bookmark the {0} tab in the top row}" />
                                                <CheckBox x:Name="OnlyToggle" Grid.Column="5" Style="{StaticResource Toggle}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                          IsChecked="{Binding Enabled}" ToolTip="Turn the whole tab off"
                                                          AutomationProperties.Name="{Binding Name, StringFormat=Turn the {0} tab off}" />
                                            </Grid>

                                            <!-- A tab made of several features: each switch turns one part of the tab on or off. -->
                                            <ItemsControl x:Name="Features" ItemsSource="{Binding Features}" Margin="80,6,0,0" Visibility="Collapsed" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="0,8,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" />
                                                                </StackPanel>
                                                                <CheckBox Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                                          AutomationProperties.Name="{Binding Name, StringFormat=Turn {0} on or off}" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding HasSeveralFeatures}" Value="True">
                                            <Setter TargetName="Features" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                            <Setter TargetName="Up" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter TargetName="Down" Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsShown}" Value="False">
                                            <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Laptop battery" />
                        <s:SettingCard Glyph="&#xE83F;" Header="Show battery"
                                       Description="Header chip on laptops. At 20% ATOLL warns once; from 10% down the level stays in the pill until it charges or rises above 10%.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowBattery}" AutomationProperties.Name="Show battery" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Home" />
                        <s:SettingCard Glyph="&#xE80F;" Header="Home tab" Description="A dashboard of what's playing, the weather, your timer, this month and what's next.">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Style="{StaticResource BookmarkToggle}" IsChecked="{Binding HomeBookmarked}" VerticalAlignment="Center"
                                              ToolTip="Keep in the top row" AutomationProperties.Name="Keep the Home tab in the top row" />
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding HomeEnabled}" Margin="12,0,0,0"
                                          AutomationProperties.Name="Show the Home tab" />
                            </StackPanel>
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE71D;" Header="Cards on Home" Description="Cards for features that are off never show."
                                       IsEnabled="{Binding HomeEnabled}">
                            <WrapPanel MaxWidth="330">
                                <CheckBox Content="Now playing" IsChecked="{Binding HomeMedia}" Margin="0,0,14,6" />
                                <CheckBox Content="Weather" IsChecked="{Binding HomeWeather}" Margin="0,0,14,6" />
                                <CheckBox Content="Timer" IsChecked="{Binding HomeTimer}" Margin="0,0,14,6" />
                                <CheckBox Content="Month" IsChecked="{Binding HomeCalendar}" Margin="0,0,14,6" />
                                <CheckBox Content="Up next" IsChecked="{Binding HomeUpNext}" Margin="0,0,14,6" />
                                <CheckBox Content="Game" IsChecked="{Binding HomeGame}" Margin="0,0,14,6" />
                            </WrapPanel>
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Media" />
                        <s:SettingCard Glyph="&#xE8D6;" Header="Show synced lyrics"
                                       Description="Looks up the playing song's title and artist on lrclib.net and shows the current line in the media tab.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowLyrics}" AutomationProperties.Name="Show synced lyrics" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Clipboard and files" />
                        <s:SettingCard Glyph="&#xE72E;" Header="Privacy"
                                       Description="Clipboard history stays in memory and is cleared when ATOLL closes. Copies from password managers are skipped. The shelf stores file locations only, never the files." />
                    </StackPanel>

                    <!-- ===================== Notifications ===================== -->
                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=3}">
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,12,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding NotificationGuideTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding NotificationGuideDescription}" Style="{StaticResource Hint}" Margin="0,8,0,16" />
                                <TextBlock Text="{Binding NotificationRegistrationStep}" FontSize="13" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding NotificationPermissionStep}" FontSize="13" Margin="0,0,0,16" />
                                <WrapPanel>
                                    <Button Content="{Binding NotificationActionLabel}" Command="{Binding SetupNotificationsCommand}" Padding="16,8" Margin="0,0,8,8" />
                                    <Button Content="Check again" Command="{Binding RefreshNotificationAccessCommand}" Padding="14,8" Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock Text="{Binding NotificationSetupMessage}" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <s:SettingCard Glyph="&#xEA8F;" Header="Show notifications in the island" Description="Enable this feature to show new notifications and keep recent history.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding NotificationModuleEnabled}" AutomationProperties.Name="Enable the Notifications feature" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Focus" />
                        <s:SettingCard Glyph="&#xE708;" Header="Do Not Disturb"
                                       Description="Silence ATOLL's popups and sounds. Start it from the moon chip, the tray, or the command palette.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding FocusEnabled}" AutomationProperties.Name="Do Not Disturb" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE7B3;" Header="Focus behavior" IsEnabled="{Binding FocusEnabled}">
                            <WrapPanel MaxWidth="330">
                                <CheckBox Content="Show the moon chip" IsChecked="{Binding ShowFocusChip}" Margin="0,0,18,6" />
                                <CheckBox Content="Follow Windows Focus" IsChecked="{Binding FollowWindowsFocus}" Margin="0,0,18,6" />
                            </WrapPanel>
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Privacy" />
                        <s:SettingCard Glyph="&#xE890;" Header="Show message text"
                                       Description="Turn off while screen sharing so ATOLL shows only the app name.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowNotificationContent}" AutomationProperties.Name="Show message text" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Muted apps" />
                        <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,0"
                                   Text="None yet. Mute an app with the bell button on its notification in ATOLL."
                                   Visibility="{Binding HasMutedApps, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                        <ItemsControl x:Name="MutedList" ItemsSource="{Binding MutedApps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <s:SettingCard Glyph="&#xE7ED;" Header="{Binding}">
                                        <Button Content="Unmute" Padding="14,5" Command="{Binding DataContext.UnmuteCommand, ElementName=MutedList}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding StringFormat=Unmute {0}}" />
                                    </s:SettingCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===================== Claude Code ===================== -->
                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=4}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Live activity" />
                        <TextBlock Text="Track Claude Code, Codex, OpenCode, and Hermes in one place. Each adapter sends local activity summaries; existing hooks and settings are kept."
                                   Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="4,0,0,12" />
                        <ItemsControl ItemsSource="{Binding AgentIntegrations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <s:SettingCard Glyph="&#xE99A;" Header="{Binding Name}" Description="{Binding Status}" ToolTip="{Binding Path}">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding ActionLabel}" Padding="14,5" Margin="0,0,8,0"
                                                        Command="{Binding InstallCommand}" AutomationProperties.Name="{Binding ActionAccessibleName}" />
                                                <Button Content="Remove" Padding="14,5" Command="{Binding RemoveCommand}"
                                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                        AutomationProperties.Name="{Binding Name, StringFormat=Remove {0} integration}" />
                                            </StackPanel>
                                        </s:SettingCard>
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="4,2,0,0"
                                                   Visibility="{Binding Message, Converter={StaticResource EmptyToCollapsed}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Your own API keys" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="4,0,0,12"
                                   Text="No coding agent needed. Add an OpenAI, Anthropic, DeepSeek or OpenAI-compatible key, then give your app or SDK the address ATOLL shows here and the gateway token as its API key. ATOLL forwards each request with your key and shows live requests and token totals in the island's API keys tab. Keys are encrypted on this PC; prompts and replies are never saved." />
                        <s:SettingCard Glyph="&#xE968;" Header="Local API gateway" Description="Listens only on this PC, at 127.0.0.1:47831. Turns on when you add a key.">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Copy gateway token" Padding="14,5" Margin="0,0,16,0" Click="OnCopyGatewayToken"
                                        AutomationProperties.Name="Copy gateway token" />
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GatewayEnabled}" VerticalAlignment="Center"
                                          AutomationProperties.Name="Local API gateway" />
                            </StackPanel>
                        </s:SettingCard>
                        <ItemsControl x:Name="ProviderList" ItemsSource="{Binding ProviderAccounts}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <s:SettingCard Glyph="&#xE8D7;" Header="{Binding Name}" Description="{Binding Detail}" ToolTip="{Binding GatewayUrl}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Copy address" Padding="14,5" Margin="0,0,8,0" Tag="{Binding GatewayUrl}" Click="OnCopyProviderAddress"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Copy the address for {0}}" />
                                            <Button Content="Remove" Padding="14,5" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.RemoveProviderCommand, ElementName=ProviderList}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                        </StackPanel>
                                    </s:SettingCard>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="52,14,16,14" Margin="0,0,0,4" AutomationProperties.Name="Add an API key">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="Add an API key" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Text="Provider" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4" ItemsSource="{Binding ProviderPresets}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding ProviderPreset}" AutomationProperties.Name="Provider" />
                                <TextBlock Grid.Row="2" Text="Name" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding NewProviderName, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Name" />
                                <TextBlock Grid.Row="3" Text="API base URL" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding NewProviderUrl, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="API base URL" />
                                <TextBlock Grid.Row="4" Text="API key" VerticalAlignment="Center" />
                                <PasswordBox x:Name="ProviderKey" Grid.Row="4" Grid.Column="1" Margin="0,4" AutomationProperties.Name="API key" />
                                <TextBlock Grid.Row="5" Text="Metrics key" VerticalAlignment="Top" Margin="0,10,0,0" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,4">
                                    <PasswordBox x:Name="ProviderMetricsKey" AutomationProperties.Name="Metrics key (optional)" />
                                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="Optional. An OpenAI organization admin key adds costs and usage; DeepSeek shows your balance with the API key." />
                                </StackPanel>
                                <Button Grid.Row="6" Grid.Column="1" Content="Add key" Padding="14,5" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Click="OnAddProvider" AutomationProperties.Name="Add key" />
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding ProviderMessage}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="4,2,0,0"
                                   Visibility="{Binding ProviderMessage, Converter={StaticResource EmptyToCollapsed}}" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Sounds" />
                        <s:SettingCard Glyph="&#xE73E;" Header="When a session finishes">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SoundOnDone}" AutomationProperties.Name="Sound when a session finishes" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE7BA;" Header="When a session needs permission">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding SoundOnAttention}" AutomationProperties.Name="Sound when a session needs permission" />
                        </s:SettingCard>
                    </StackPanel>

                    <!-- ===================== Calendar ===================== -->
                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=5}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Alerts" />
                        <s:SettingCard Glyph="&#xE823;" Header="Alert me before an event"
                                       Description="ATOLL pops up this many minutes before an event starts. Set to 0 to turn alerts off.">
                            <StackPanel Orientation="Horizontal">
                                <Slider Width="200" Minimum="0" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding CalendarAlertMinutes}" AutomationProperties.Name="Alert me before an event" />
                                <TextBlock Style="{StaticResource ValueText}" Text="{Binding CalendarAlertMinutes, StringFormat={}{0} min}" />
                            </StackPanel>
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE767;" Header="Sound on alert">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CalendarSoundOnAlert}" AutomationProperties.Name="Sound on alert" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Calendars" />
                        <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,10"
                                   Text="Paste each calendar's private ICS link. Google: Calendar settings → the calendar → “Secret address in iCal format”. Outlook / M365: Settings → Calendar → Shared calendars → “Publish a calendar”." />

                        <ItemsControl x:Name="CalendarList" ItemsSource="{Binding CalendarSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="6" Padding="16,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource Hint}" Text="Color" Margin="0,0,0,4" />
                                                <s:ColorPicker Value="{Binding Color}" Label="Calendar color" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource Hint}" Text="Name" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Calendar name" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                                <TextBlock Style="{StaticResource Hint}" Text="ICS link" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Calendar ICS link" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                                <Button Content="Save" Padding="14,5" Margin="0,0,0,4"
                                                        Command="{Binding DataContext.SaveCalendarCommand, ElementName=CalendarList}" CommandParameter="{Binding}" />
                                                <Button Content="Remove" Padding="14,5"
                                                        Command="{Binding DataContext.RemoveCalendarCommand, ElementName=CalendarList}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Add calendar" Padding="14,5" Command="{Binding AddCalendarCommand}" />
                            <TextBlock Text="{Binding CalendarMessage}" Style="{StaticResource Hint}" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Visibility="{Binding CalendarMessage, Converter={StaticResource EmptyToCollapsed}}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Privacy" />
                        <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,4"
                                   Text="ICS links give read-only access, and anyone with a link can read that calendar. ATOLL stores them encrypted with your Windows login (DPAPI) so they can't be read from the settings file. ATOLL only downloads the calendars, and only from the servers you add here." />
                    </StackPanel>

                    <!-- ===================== Games ===================== -->
                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=7}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="While you play" />
                        <s:SettingCard Glyph="&#xE7FC;" Header="Island while playing"
                                       Description="Overlay keeps the game, play time and performance in a small pill. Hidden keeps the island out of the way.">
                            <ComboBox Width="250" ItemsSource="{Binding GameModes}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding GameMode}" AutomationProperties.Name="Island while playing" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE7ED;" Header="Mute notifications while playing"
                                       Description="Keep alerts quiet until the session ends.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GameMuteNotifications}"
                                      AutomationProperties.Name="Mute notifications while playing" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE9D9;" Header="Show performance"
                                       Description="CPU, GPU and GPU temperature in the game pill and the Games tab.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GameShowPerformance}"
                                      AutomationProperties.Name="Show game performance" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE823;" Header="Show play time"
                                       Description="How long the current session has run.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GameShowPlayTime}"
                                      AutomationProperties.Name="Show play time" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xEA8F;" Header="Announce when a game starts"
                                       Description="A short island with the game name when a session begins.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GameAnnounceStart}"
                                      AutomationProperties.Name="Announce when a game starts" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Detection" />
                        <s:SettingCard Glyph="&#xE7FC;" Header="Detect games automatically"
                                       Description="Notice games from Steam, Epic, the Xbox app and common launchers. Off leaves the library and the Minecraft server available.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GameDetect}"
                                      AutomationProperties.Name="Detect games automatically" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE8F1;" Header="Watch these libraries"
                                       Description="The Games tab and the Launcher only list what you keep on here.">
                            <WrapPanel MaxWidth="330">
                                <CheckBox Content="Steam" IsChecked="{Binding GameScanSteam}" Margin="0,0,16,6" />
                                <CheckBox Content="Epic" IsChecked="{Binding GameScanEpic}" Margin="0,0,16,6" />
                                <CheckBox Content="Minecraft" IsChecked="{Binding GameScanMinecraft}" Margin="0,0,16,6" />
                            </WrapPanel>
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Minecraft server" />
                        <s:SettingCard Glyph="&#xE968;" Header="Server address"
                                       Description="host or host:port. Leave it empty to turn the check off.">
                            <TextBox Width="260" Text="{Binding MinecraftServer}" AutomationProperties.Name="Minecraft server address" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE8B7;" Header="Show the server in Games"
                                       Description="Players, ping and MOTD in the Games tab.">
                            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding GameShowServer}"
                                      AutomationProperties.Name="Show the Minecraft server in Games" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE916;" Header="Check every"
                                       Description="How often to ask the server for players and ping.">
                            <ComboBox Width="200" ItemsSource="{Binding GameServerIntervals}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding GameServerInterval}" AutomationProperties.Name="Minecraft server check interval" />
                        </s:SettingCard>
                    </StackPanel>

                    <!-- ===================== About ===================== -->
                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=8}">
                        <StackPanel Orientation="Horizontal" Margin="2,12,0,18">
                            <Border Width="56" Height="56" CornerRadius="12.3" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Image Source="{StaticResource Atoll.Logo}" AutomationProperties.Name="ATOLL logo" />
                            </Border>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ATOLL" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}">
                                    <Run Text="A dynamic island for Windows · version " /><Run Text="{Binding Version, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <s:SettingCard Glyph="&#xE8B7;" Header="Settings and logs" Description="{Binding DataFolder}">
                            <Button Content="Open folder" Padding="14,5" Command="{Binding OpenDataFolderCommand}" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE946;" Header="Welcome setup"
                                       Description="Meet the island again and choose which tabs sit in the top row.">
                            <Button Content="Open setup" Padding="14,5" Click="OnOpenOnboarding" />
                        </s:SettingCard>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="Updates" />
                        <s:SettingCard Glyph="&#xE777;" Header="Check for updates" Description="{Binding UpdateDescription}">
                            <Button Content="Check now" Padding="14,5" Command="{Binding CheckForUpdatesCommand}" />
                        </s:SettingCard>
                        <TextBlock Text="{Binding UpdateMessage}" Style="{StaticResource Hint}" Margin="4,2,0,0"
                                   Visibility="{Binding UpdateMessage, Converter={StaticResource EmptyToCollapsed}}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding PageIndex, Converter={StaticResource PageVisible}, ConverterParameter=6}">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Location" />
                        <TextBlock Text="{Binding WeatherLocation}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,0,12" />
                        <Expander Header="Location and units" IsExpanded="{Binding WeatherLocationExpanded}">
                        <StackPanel Margin="0,12,0,0">
                        <WrapPanel IsEnabled="{Binding CanChooseWeatherLocation}" Margin="0,0,0,12">
                            <Button Content="Use my location" Command="{Binding UseWeatherLocationCommand}" Padding="14,7" Margin="0,0,8,8" />
                            <Button Content="Windows location settings" Command="{Binding OpenLocationSettingsCommand}" Padding="14,7" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="Or search for a city" Style="{StaticResource Hint}" Margin="2,0,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Search" Command="{Binding SearchWeatherCommand}" IsEnabled="{Binding CanChooseWeatherLocation}" Padding="16,7" Margin="8,0,0,0" />
                            <TextBox Text="{Binding WeatherQuery, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search for a city">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchWeatherCommand}" /></TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Text="{Binding WeatherLocationMessage}" Style="{StaticResource Hint}" Margin="2,8,0,8" AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl x:Name="CityResults" ItemsSource="{Binding WeatherResults}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Command="{Binding DataContext.UseWeatherPlaceCommand, ElementName=CityResults}" CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6" AutomationProperties.Name="{Binding Name, StringFormat=Use {0}}">
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,16" Text="Location is requested only when you click. ATOLL rounds Windows coordinates to an area before saving or sending them to Open-Meteo. City searches send the city name. Your location is not tracked in the background." />
                        <s:SettingCard Glyph="&#xE9CA;" Header="Temperature and wind units">
                            <ComboBox Width="220" ItemsSource="{Binding TemperatureUnitChoices}" DisplayMemberPath="Label"
                                      SelectedValuePath="Value" SelectedValue="{Binding TemperatureUnits}" AutomationProperties.Name="Weather units" />
                        </s:SettingCard>
                        <s:SettingCard Glyph="&#xE72C;" Header="Update forecast" Description="Forecasts update automatically every 20 minutes.">
                            <Button Content="Refresh" Command="{Binding Weather.RefreshCommand}" Padding="14,7" />
                        </s:SettingCard>
                        </StackPanel>
                        </Expander>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Forecast" />
                        <TextBlock Style="{StaticResource Hint}" Text="Choose a location above to see current conditions, rain timing, and a seven-day forecast."
                                   Visibility="{Binding Weather.HasCity, Converter={StaticResource Island.InverseBoolToVisibility}}" />
                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                Visibility="{Binding Weather.HasCity, Converter={StaticResource BoolToVisibility}}">
                            <weather:WeatherDetails DataContext="{Binding Weather}" ScrollViewer.VerticalScrollBarVisibility="Disabled" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    HoverBrush="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
