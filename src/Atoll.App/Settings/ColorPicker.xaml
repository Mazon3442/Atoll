<UserControl x:Class="Atoll.Settings.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:Atoll.Settings"
             x:Name="Picker" Focusable="False">
    <UserControl.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
            <DrawingBrush.Drawing><DrawingGroup>
                <GeometryDrawing Brush="#FFF4F4F4" Geometry="M0,0 H10 V10 H0Z" />
                <GeometryDrawing Brush="#FFC9C9C9" Geometry="M0,0 H5 V5 H0Z M5,5 H10 V10 H5Z" />
            </DrawingGroup></DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <ToggleButton x:Name="SwatchButton" IsChecked="{Binding IsOpen, ElementName=Flyout, Mode=TwoWay}"
                      Padding="8,5" MinHeight="36" Cursor="Hand"
                      AutomationProperties.Name="{Binding Label, ElementName=Picker}" ToolTip="Choose a color">
            <StackPanel Orientation="Horizontal">
                <Border Width="24" Height="24" Background="{StaticResource Checker}" CornerRadius="4" ClipToBounds="True">
                    <Border x:Name="Swatch" CornerRadius="4" BorderBrush="#80808080" BorderThickness="1" />
                </Border>
                <TextBlock x:Name="SwatchHex" Width="88" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,0,2,0" VerticalAlignment="Center" />
            </StackPanel>
        </ToggleButton>
        <Popup x:Name="Flyout" Placement="Bottom" PlacementTarget="{Binding ElementName=SwatchButton}"
               StaysOpen="False" AllowsTransparency="True" VerticalOffset="8" Opened="OnOpened" Closed="OnClosed">
            <Border Width="312" Padding="20" CornerRadius="12" BorderThickness="1"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    PreviewKeyDown="OnFlyoutKeyDown" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="{Binding Label, ElementName=Picker}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <s:ColorSquare x:Name="Square" Height="150" ColorChanged="OnSquareChanged" Margin="0,0,0,14"
                                   AutomationProperties.Name="Saturation and brightness"
                                   AutomationProperties.HelpText="Left and right adjust saturation. Up and down adjust brightness. RGB fields are also available." />
                    <TextBlock Text="Hue" Style="{StaticResource FieldLabel}" />
                    <Slider x:Name="HueSlider" Minimum="0" Maximum="359.99" SmallChange="1" LargeChange="15"
                            ValueChanged="OnHueChanged" AutomationProperties.Name="Hue" Height="24" Margin="0,0,0,14">
                        <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Red" Offset="0" /><GradientStop Color="Yellow" Offset="0.1667" />
                            <GradientStop Color="Lime" Offset="0.3333" /><GradientStop Color="Cyan" Offset="0.5" />
                            <GradientStop Color="Blue" Offset="0.6667" /><GradientStop Color="Magenta" Offset="0.8333" />
                            <GradientStop Color="Red" Offset="1" />
                        </LinearGradientBrush></Slider.Background>
                        <Slider.Template><ControlTemplate TargetType="Slider">
                            <Grid Background="Transparent" Margin="5,0">
                                <Border Background="{TemplateBinding Background}" Height="10" CornerRadius="5" />
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Width="12" Height="22">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Border Background="#202020" BorderBrush="White" BorderThickness="2" CornerRadius="5" />
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton>
                                </Track>
                                <Border x:Name="FocusRing" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2" CornerRadius="5" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Slider.Template>
                    </Slider>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Red" Style="{StaticResource FieldLabel}" /><TextBox x:Name="RedField" Tag="Red" LostKeyboardFocus="OnFieldCommit" AutomationProperties.Name="Red, 0 to 255" /></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Green" Style="{StaticResource FieldLabel}" /><TextBox x:Name="GreenField" Tag="Green" LostKeyboardFocus="OnFieldCommit" AutomationProperties.Name="Green, 0 to 255" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Blue" Style="{StaticResource FieldLabel}" /><TextBox x:Name="BlueField" Tag="Blue" LostKeyboardFocus="OnFieldCommit" AutomationProperties.Name="Blue, 0 to 255" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Opacity" Style="{StaticResource FieldLabel}" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="66" /><ColumnDefinition Width="20" /></Grid.ColumnDefinitions>
                        <Slider x:Name="AlphaSlider" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" ValueChanged="OnAlphaChanged" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Color opacity" />
                        <TextBox x:Name="AlphaField" Tag="Opacity" Grid.Column="1" LostKeyboardFocus="OnFieldCommit" AutomationProperties.Name="Opacity, 0 to 100 percent" />
                        <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="5,0,0,0" />
                    </Grid>
                    <TextBlock Text="Hex" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HexField" Tag="Hex" LostKeyboardFocus="OnFieldCommit" AutomationProperties.Name="Hex color" />
                    <TextBlock Text="#RRGGBB or #AARRGGBB" Style="{StaticResource FieldLabel}" Margin="0,5,0,0" />
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    <DockPanel Margin="0,16,0,0">
                        <Button DockPanel.Dock="Right" Content="Done" Padding="16,6" Click="OnDone" />
                        <TextBlock Text="Applies as you edit" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
