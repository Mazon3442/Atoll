<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell">

    <!-- A downloaded update waiting for a restart. Peek carries the question; the smaller sizes just say it is ready. -->
    <DataTemplate x:Key="UpdatePromptViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <shell:Icon Kind="refresh" Size="14" Foreground="{DynamicResource Island.Accent}" />
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="UpdatePromptViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <shell:Icon Kind="refresh" Size="18" Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Button Style="{StaticResource Island.ChipButton}" Content="Restart" Margin="0,0,6,0" FontWeight="SemiBold"
                        Foreground="{DynamicResource Island.Accent}" Command="{Binding RestartCommand}"
                        AutomationProperties.Name="Restart ATOLL to finish updating" />
                <Button Style="{StaticResource Island.ChipButton}" Content="Later" Margin="0" Command="{Binding LaterCommand}"
                        AutomationProperties.Name="Update the next time ATOLL starts" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="UpdatePromptViewModel.Mini">
        <shell:Icon Kind="refresh" Size="14" Foreground="{DynamicResource Island.Accent}" />
    </DataTemplate>

</ResourceDictionary>
