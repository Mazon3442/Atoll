<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:Atoll.Shell">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Scrollbars.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource Atoll.ScrollBar}">
        <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
    </Style>

    <BooleanToVisibilityConverter x:Key="Island.BoolToVisibility" />
    <shell:InverseBoolToVisibilityConverter x:Key="Island.InverseBoolToVisibility" />

    <!-- Defaults; ThemeService replaces these at startup and on settings change. -->
    <SolidColorBrush x:Key="Island.Background" Color="Black" />
    <SolidColorBrush x:Key="Island.Foreground" Color="White" />
    <SolidColorBrush x:Key="Island.Subtle" Color="White" Opacity="0.6" />
    <SolidColorBrush x:Key="Island.Hover" Color="White" Opacity="0.12" />
    <SolidColorBrush x:Key="Island.Accent" Color="#0A84FF" />
    <SolidColorBrush x:Key="Island.AccentText" Color="#0A84FF" />
    <SolidColorBrush x:Key="Island.Rim" Color="Transparent" />
    <SolidColorBrush x:Key="Island.Surface" Color="White" Opacity="0.08" />
    <SolidColorBrush x:Key="Island.Raised" Color="White" Opacity="0.16" />
    <SolidColorBrush x:Key="Island.SelectedBackground" Color="#F2F2F7" />
    <SolidColorBrush x:Key="Island.SelectedForeground" Color="#0B0B0D" />
    <!-- Opaque island color for popups; Island.Background is near-transparent in glass mode. -->
    <SolidColorBrush x:Key="Island.Menu" Color="Black" />

    <Style x:Key="Island.FocusVisual" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate>
            <Border BorderBrush="{DynamicResource Island.Foreground}" BorderThickness="1" CornerRadius="6" Margin="-2" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <FontFamily x:Key="Island.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Island.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Island.IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource Island.IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared text actions sit inside the enclosing island surface. -->
    <Style x:Key="Island.ChipButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Island.Surface}" CornerRadius="9" Padding="12,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented switch used by Launcher and Notes. -->
    <Style x:Key="Island.SegmentItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="12" Padding="16,5" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.SelectedBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource Island.SelectedForeground}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input on the island surface. -->
    <Style x:Key="Island.Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Island.Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet round check for reminders and to-dos. -->
    <Style x:Key="Island.Check" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="20" Height="20" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="9" BorderThickness="1"
                                BorderBrush="{DynamicResource Island.Subtle}" Background="Transparent">
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource Island.IconFont}" FontSize="10"
                                       Foreground="{DynamicResource Island.SelectedForeground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Island.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Island.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Island.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small text picker: shows the current choice and opens a short list in the island colors. -->
    <Style x:Key="Island.Picker" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MaxDropDownHeight" Value="180" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="8,5">
                                    <DockPanel>
                                        <TextBlock x:Name="Check" DockPanel.Dock="Right" Text="&#xE73E;" FontFamily="{StaticResource Island.IconFont}"
                                                   FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Island.AccentText}" Visibility="Hidden" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press" Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="6,2">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Island.IconFont}" FontSize="8"
                                           Margin="5,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Placement="Bottom" VerticalOffset="4" Focusable="False"
                               PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                            <Border Background="{DynamicResource Island.Menu}" BorderBrush="{DynamicResource Island.Hover}" BorderThickness="1"
                                    CornerRadius="10" Padding="4" MinWidth="140" MaxWidth="260" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Selection" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin slider for the dark island panel. -->
    <Style x:Key="Island.SliderPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Island.Slider" TargetType="Slider">
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" Height="20">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Island.SliderPart}"
                                          Background="{DynamicResource Island.Foreground}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Island.SliderPart}"
                                          Background="{DynamicResource Island.Hover}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Width="14" Height="14">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{DynamicResource Island.Foreground}" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab strip of the expanded panel: one round glyph per module. -->
    <!-- Must stay focusable: ListBoxItem only selects on click when it can take focus. -->
    <!-- Tabs: round icon chips; the selected one widens into a pill with its name. -->
    <Style x:Key="Island.TabItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="15" Padding="9,7" MinWidth="32">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Raised}" />
                            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                            <Setter TargetName="Bg" Property="Padding" Value="12,7,14,7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Vertical row in the overflow menu: every section with its icon and name. -->
    <Style x:Key="Island.TabMenuItem" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource Island.Subtle}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Descriptor.Name}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="10,7" Margin="0,1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Raised}" />
                            <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Round icon chip on the island surface: header status chips, play/pause, month arrows. -->
    <Style x:Key="Island.RoundButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{DynamicResource Island.Surface}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static shell:PillRadius.Instance}}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Raised}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A full-width list row that is a button (games). -->
    <Style x:Key="Island.RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="9" Padding="8,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A side activity capsule: module icon, short live label, and a quiet module tint. -->
    <DataTemplate x:Key="SideChipViewModel.Mini">
        <Border x:Name="Surface" Background="{Binding SurfaceBrush}" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static shell:PillRadius.Instance}}" Padding="10,0"
                ToolTip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
            <Grid>
                <StackPanel x:Name="Capsule" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <shell:Icon Kind="{Binding Glyph}" Size="14" Foreground="{Binding TintBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0"
                               MaxWidth="74" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource Island.Foreground}" />
                </StackPanel>
                <Grid x:Name="Ring" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Visibility="Collapsed">
                    <Ellipse Width="26" Height="26" Stroke="{DynamicResource Island.Hover}" StrokeThickness="2.5" />
                    <Path Data="{Binding RingArc}" Stroke="{Binding TintBrush}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBlock Text="{Binding RingText}" FontSize="8.5" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Island.Foreground}" />
                </Grid>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRing}" Value="True">
                <Setter TargetName="Capsule" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Surface" Property="Padding" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ShowLabel}" Value="False">
                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Surface" Property="Padding" Value="0" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Two side activities on one side: one longer pill, each activity in its own tappable cell. -->
    <Style x:Key="SideChip.Cell" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Island.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate x:Key="SideChipPair.Mini">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource SideChip.Cell}" Width="{Binding FirstWidth}" Command="{Binding OpenFirstCommand}"
                    ToolTip="{Binding First.Label}" AutomationProperties.Name="{Binding First.Label}">
                <ContentPresenter Content="{Binding First}" ContentTemplate="{StaticResource SideChipViewModel.Mini}" />
            </Button>
            <Button Style="{StaticResource SideChip.Cell}" Width="{Binding SecondWidth}" Command="{Binding OpenSecondCommand}"
                    ToolTip="{Binding Second.Label}" AutomationProperties.Name="{Binding Second.Label}">
                <ContentPresenter Content="{Binding Second}" ContentTemplate="{StaticResource SideChipViewModel.Mini}" />
            </Button>
        </StackPanel>
    </DataTemplate>

    <!-- Used when an activity's view model has no ".Mini" template. -->
    <DataTemplate x:Key="Fallback.Mini">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource Island.Accent}" />
    </DataTemplate>

</ResourceDictionary>
