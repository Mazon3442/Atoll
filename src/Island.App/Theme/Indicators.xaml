<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Level bar: Value 0-1 drives a ScaleTransform so no converter is needed. -->
    <DataTemplate x:Key="Island.LevelBar">
        <Grid Width="90" Height="4">
            <Border CornerRadius="2" Background="{DynamicResource Island.Hover}" />
            <Border CornerRadius="2" Background="{DynamicResource Island.Foreground}" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="{Binding Value, FallbackValue=0}" />
                </Border.RenderTransform>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="IndicatorViewModel.Compact">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="14"
                       VerticalAlignment="Center" />
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Island.LevelBar}"
                              Margin="12,0,0,0" VerticalAlignment="Center"
                              Visibility="{Binding HasValue, Converter={StaticResource Island.BoolToVisibility}}" />
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="IndicatorViewModel.Peek">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="22"
                       Foreground="{DynamicResource Island.Accent}" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Island.Subtle}"
                           MaxWidth="320" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasDetail, Converter={StaticResource Island.BoolToVisibility}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Island.LevelBar}"
                                  Margin="0,6,0,0" HorizontalAlignment="Left"
                                  Visibility="{Binding HasValue, Converter={StaticResource Island.BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="IndicatorViewModel.Mini">
        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Island.IconFont}" FontSize="13" />
    </DataTemplate>

</ResourceDictionary>
