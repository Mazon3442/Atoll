<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Defaults; ThemeService replaces these at startup and on settings change. -->
    <SolidColorBrush x:Key="Island.Background" Color="Black" />
    <SolidColorBrush x:Key="Island.Foreground" Color="White" />
    <SolidColorBrush x:Key="Island.Subtle" Color="White" Opacity="0.6" />
    <SolidColorBrush x:Key="Island.Hover" Color="White" Opacity="0.12" />
    <SolidColorBrush x:Key="Island.Accent" Color="#0A84FF" />

    <FontFamily x:Key="Island.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Island.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Island.IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Island.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource Island.IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab strip of the expanded panel: one round glyph per module. -->
    <Style x:Key="Island.TabItem" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="14" Padding="10,5">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Island.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Used when an activity's view model has no ".Mini" template. -->
    <DataTemplate x:Key="Fallback.Mini">
        <Ellipse Width="8" Height="8" Fill="{DynamicResource Island.Accent}" />
    </DataTemplate>

</ResourceDictionary>
